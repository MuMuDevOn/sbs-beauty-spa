<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="SBSBeautySpa.Mobile.Views.TrackOrderPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
             xmlns:vm="clr-namespace:SBSBeautySpa.Mobile.ViewModels"
             xmlns:conv="clr-namespace:SBSBeautySpa.Mobile.Converters"
             x:DataType="vm:TrackOrderViewModel"
             BackgroundColor="White"
             Shell.NavBarIsVisible="False">

    <ContentPage.Resources>
        <Color x:Key="DeepNavy">#1B2A4A</Color>
        <Color x:Key="AccentBlue">#2F63E0</Color>
        <Color x:Key="InkText">#111827</Color>
        <Color x:Key="MutedGray">#8A93A6</Color>
        <Color x:Key="SoftBlue">#EEF3FD</Color>
        <Color x:Key="CardStroke">#E3E9F5</Color>
        <conv:IsNotNullConverter x:Key="IsNotNull" />
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*">
        <Grid Grid.Row="0" Padding="20,44,20,10" ColumnDefinitions="Auto,*" ColumnSpacing="14">
            <Image Grid.Column="0" WidthRequest="26" HeightRequest="26" VerticalOptions="Center"
                   mi:MauiIcon.Value="{mi:Material Icon=ArrowBack, IconColor=#111827}">
                <Image.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnBackTapped" />
                </Image.GestureRecognizers>
            </Image>
            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                <Label Text="Track order" FontSize="26" FontFamily="OpenSansSemibold" TextColor="{StaticResource InkText}" />
                <Label Text="{Binding ReferenceText}" FontSize="13" TextColor="{StaticResource MutedGray}"
                       IsVisible="{Binding ReferenceText, Converter={StaticResource IsNotNull}}" />
            </VerticalStackLayout>
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16,4,16,28" Spacing="16">

                <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="{StaticResource AccentBlue}" />

                <Label Text="{Binding ErrorMessage}" FontSize="13" TextColor="#B3261E" HorizontalTextAlignment="Center"
                       IsVisible="{Binding ErrorMessage, Converter={StaticResource IsNotNull}}" />

                <!-- Where is it now -->
                <Border Padding="18" BackgroundColor="{StaticResource SoftBlue}" StrokeThickness="0"
                        IsVisible="{Binding StatusText, Converter={StaticResource IsNotNull}}">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="18" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="6">
                        <Label Text="STATUS" FontSize="11" FontFamily="OpenSansSemibold" TextColor="{StaticResource MutedGray}" />
                        <Label Text="{Binding StatusText}" FontSize="22" FontFamily="OpenSansSemibold" TextColor="{Binding StatusColor}" />
                        <Label Text="{Binding Message}" FontSize="14" TextColor="#4B5563"
                               IsVisible="{Binding Message, Converter={StaticResource IsNotNull}}" />
                        <Label Text="Demo tracking: this parcel is simulated." FontSize="12" TextColor="{StaticResource AccentBlue}"
                               IsVisible="{Binding IsDemo}" />
                    </VerticalStackLayout>
                </Border>

                <!-- Timeline -->
                <VerticalStackLayout Spacing="0" Padding="6,4,6,0" BindableLayout.ItemsSource="{Binding Steps}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:TrackingStepItem">
                            <Grid ColumnDefinitions="24,*" ColumnSpacing="14">
                                <Grid Grid.Column="0" RowDefinitions="Auto,*">
                                    <Border Grid.Row="0" WidthRequest="20" HeightRequest="20" StrokeThickness="0"
                                            BackgroundColor="{Binding DotColor}" HorizontalOptions="Center">
                                        <Border.StrokeShape>
                                            <Ellipse />
                                        </Border.StrokeShape>
                                    </Border>
                                    <BoxView Grid.Row="1" WidthRequest="2" MinimumHeightRequest="26" Color="{Binding LineColor}"
                                             IsVisible="{Binding ShowLine}" HorizontalOptions="Center" />
                                </Grid>
                                <Label Grid.Column="1" Text="{Binding Label}" FontSize="15" FontFamily="{Binding LabelFont}"
                                       TextColor="{Binding TextColor}" Margin="0,0,0,18" VerticalOptions="Start" />
                            </Grid>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <!-- Updates from the courier -->
                <VerticalStackLayout Spacing="10" IsVisible="{Binding HasEvents}">
                    <Label Text="Updates" FontSize="18" FontFamily="OpenSansSemibold" TextColor="{StaticResource InkText}" />
                    <VerticalStackLayout Spacing="10" BindableLayout.ItemsSource="{Binding Events}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:TrackingEventItem">
                                <Border Padding="14" BackgroundColor="White" Stroke="{StaticResource CardStroke}" StrokeThickness="1">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="14" />
                                    </Border.StrokeShape>
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="{Binding Title}" FontSize="14" FontFamily="OpenSansSemibold" TextColor="{StaticResource InkText}" />
                                        <Label Text="{Binding Location}" FontSize="13" TextColor="#4B5563" IsVisible="{Binding HasLocation}" />
                                        <Label Text="{Binding DateText}" FontSize="12" TextColor="{StaticResource MutedGray}" />
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>

                <Button Text="Refresh" FontFamily="OpenSansSemibold" FontSize="15" HeightRequest="50" CornerRadius="16"
                        BackgroundColor="{StaticResource SoftBlue}" TextColor="{StaticResource AccentBlue}"
                        Command="{Binding LoadCommand}" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
