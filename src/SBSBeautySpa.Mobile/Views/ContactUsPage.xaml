<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
             x:Class="SBSBeautySpa.Mobile.Views.ContactUsPage"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*,Auto" Padding="20,50,20,16"
          Background="{StaticResource PageGradient}">

        <!-- Header: Back arrow + page title -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*" ColumnSpacing="14">
            <Image WidthRequest="26" HeightRequest="26" VerticalOptions="Center"
                   mi:MauiIcon.Value="{mi:Material Icon=ArrowBack, IconColor=White}">
                <Image.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnBackTapped" />
                </Image.GestureRecognizers>
            </Image>
            <Label Grid.Column="1" Text="Contact Us" Style="{StaticResource PageTitle}" />
        </Grid>

        <!-- Form -->
        <ScrollView Grid.Row="1" Margin="0,24,0,0">
            <VerticalStackLayout Spacing="10">

                <Label Text="Have a question or need help? Tell us what you need support with."
                       Style="{StaticResource HintText}" />

                <!-- Where to find us (temporary address, hard-coded) -->
                <Label Text="FIND US" Style="{StaticResource CapsLabel}" Margin="0,6,0,0" />
                <Border Style="{StaticResource GroupCard}">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" Padding="14,12">
                        <Image WidthRequest="22" HeightRequest="22" VerticalOptions="Start"
                               mi:MauiIcon.Value="{mi:Material Icon=LocationOn, IconColor=#6D3FE0}" />
                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                            <Label Text="SBS Beauty Spa" Style="{StaticResource RowTitle}" />
                            <Label Text="1 Eglin Road" Style="{StaticResource RowSubtitle}" />
                            <Label Text="Sunninghill, Sandton" Style="{StaticResource RowSubtitle}" />
                            <Label Text="Johannesburg, Gauteng, 2157" Style="{StaticResource RowSubtitle}" />
                            <Label Text="South Africa" Style="{StaticResource RowSubtitle}" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <!-- Your details -->
                <Label Text="YOUR DETAILS" Style="{StaticResource CapsLabel}" Margin="0,6,0,0" />
                <Border Style="{StaticResource GroupCard}">
                    <VerticalStackLayout>

                        <VerticalStackLayout Padding="14,10" Spacing="2">
                            <Label Text="Name" Style="{StaticResource FieldLabel}" />
                            <Entry x:Name="NameEntry" Placeholder="Your name"
                                   Style="{StaticResource FieldEntry}" />
                        </VerticalStackLayout>
                        <BoxView Style="{StaticResource Divider}" />

                        <VerticalStackLayout Padding="14,10" Spacing="2">
                            <Label Text="Email address" Style="{StaticResource FieldLabel}" />
                            <Entry x:Name="EmailEntry" Placeholder="you@example.com"
                                   Keyboard="Email"
                                   Style="{StaticResource FieldEntry}" />
                        </VerticalStackLayout>

                    </VerticalStackLayout>
                </Border>

                <!-- Your message -->
                <Label Text="YOUR MESSAGE" Style="{StaticResource CapsLabel}" Margin="0,10,0,0" />
                <Border Style="{StaticResource GroupCard}">
                    <VerticalStackLayout>

                        <Grid ColumnDefinitions="*,Auto" Padding="14,10">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="Topic" Style="{StaticResource FieldLabel}" />
                                <Picker x:Name="TopicPicker" Title="Select a topic"
                                        Style="{StaticResource FieldPicker}">
                                    <Picker.ItemsSource>
                                        <x:Array Type="{x:Type x:String}">
                                            <x:String>Booking question</x:String>
                                            <x:String>Services and pricing</x:String>
                                            <x:String>Payments</x:String>
                                            <x:String>Shop order</x:String>
                                            <x:String>Problem with the app</x:String>
                                            <x:String>Other</x:String>
                                        </x:Array>
                                    </Picker.ItemsSource>
                                </Picker>
                            </VerticalStackLayout>
                            <Label Grid.Column="1" Text="▾" FontSize="18"
                                   TextColor="{StaticResource MutedText}"
                                   VerticalOptions="Center">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnChevronTapped" />
                                </Label.GestureRecognizers>
                            </Label>
                        </Grid>
                        <BoxView Style="{StaticResource Divider}" />

                        <VerticalStackLayout Padding="14,10" Spacing="2">
                            <Label Text="Message" Style="{StaticResource FieldLabel}" />
                            <Editor x:Name="MessageEditor" HeightRequest="110"
                                    Placeholder="Describe how we can help..."
                                    Style="{StaticResource FieldEditor}" />
                        </VerticalStackLayout>

                    </VerticalStackLayout>
                </Border>

                <Label Text="For a booking question, include the booking date. Please don't include passwords or card details."
                       Style="{StaticResource HintText}" />

            </VerticalStackLayout>
        </ScrollView>

        <!-- Send -->
        <Button Grid.Row="2" Text="Send message" Margin="0,10,0,0"
                Style="{StaticResource PrimaryButton}" Clicked="OnSendClicked" />
    </Grid>
</ContentPage>