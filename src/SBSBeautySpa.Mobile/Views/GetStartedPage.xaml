<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SBSBeautySpa.Mobile.ViewModels"
             x:Class="SBSBeautySpa.Mobile.Views.GetStartedPage"
             x:DataType="vm:GetStartedViewModel"
             Shell.NavBarIsVisible="False">

    <!-- Same purple / blue / white theme as the Home, Services, Login and Sign Up pages -->
    <Grid Background="{StaticResource PageGradient}" Padding="24,60,24,40"
          RowDefinitions="Auto,*,Auto">

        <VerticalStackLayout Grid.Row="0" Spacing="0" HorizontalOptions="Center">

            <!-- The logo starts off-screen on the left and rolls into place (see GetStartedPage.xaml.cs) -->
            <Image x:Name="LogoImage"
                   Source="logo.png"
                   HeightRequest="140"
                   WidthRequest="260"
                   Aspect="AspectFit"
                   HorizontalOptions="Center"
                   Opacity="0"/>

            <Label x:Name="TaglineLabel"
                   Text="Nails • Lashes • Press-Ons"
                   TextColor="#E3DDFB"
                   FontFamily="OpenSansRegular"
                   FontSize="20"
                   Margin="0,18,0,20"
                   HorizontalOptions="Center"
                   Opacity="0"/>
        </VerticalStackLayout>

        <!-- Get Started button: purple to blue, same as the Log In / Create Account buttons -->
        <Border Grid.Row="2"
                Stroke="Transparent"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 28"
                HeightRequest="56"
                HorizontalOptions="Fill"
                Background="{StaticResource NavyButtonGradient}">
            <Border.Shadow>
                <Shadow Brush="Black" Opacity="0.25" Radius="14" Offset="0,6" />
            </Border.Shadow>

            <Button Text="Get Started"
                    Command="{Binding ContinueCommand}"
                    BackgroundColor="Transparent"
                    TextColor="White"
                    FontFamily="OpenSansSemibold"
                    FontSize="17"/>
        </Border>
    </Grid>

</ContentPage>
