<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SBSBeautySpa.Mobile.Views.ChangePasswordPage"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*,Auto" Padding="20,50,20,16"
          Background="{StaticResource PageGradient}">

        <!-- Header: Back arrow + page title -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*" ColumnSpacing="14">
            <Label Text="←" FontSize="28" TextColor="White" VerticalOptions="Center">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnBackTapped" />
                </Label.GestureRecognizers>
            </Label>
            <Label Grid.Column="1" Text="Change Password" Style="{StaticResource PageTitle}" />
        </Grid>

        <!-- Form -->
        <ScrollView Grid.Row="1" Margin="0,24,0,0">
            <VerticalStackLayout Spacing="10">

                <Label Text="Choose a new password to keep your account secure."
                       Style="{StaticResource HintText}" />

                <Label Text="PASSWORD DETAILS" Style="{StaticResource CapsLabel}" Margin="0,6,0,0" />

                <Border Style="{StaticResource GroupCard}">
                    <VerticalStackLayout>

                        <!-- Current password -->
                        <Grid ColumnDefinitions="*,Auto" Padding="14,10">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="Current password" Style="{StaticResource FieldLabel}" />
                                <Entry x:Name="CurrentPasswordEntry" IsPassword="True"
                                       Placeholder="Enter current password"
                                       Style="{StaticResource FieldEntry}" />
                            </VerticalStackLayout>
                            <Image Grid.Column="1" Source="eyeofficon.png" WidthRequest="22" HeightRequest="22"
                                   VerticalOptions="Center">
                                <Image.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnToggleTapped"
                                        CommandParameter="{x:Reference CurrentPasswordEntry}" />
                                </Image.GestureRecognizers>
                            </Image>
                        </Grid>
                        <BoxView Style="{StaticResource Divider}" />

                        <!-- New password -->
                        <Grid ColumnDefinitions="*,Auto" Padding="14,10">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="New password" Style="{StaticResource FieldLabel}" />
                                <Entry x:Name="NewPasswordEntry" IsPassword="True"
                                       Placeholder="Enter new password"
                                       Style="{StaticResource FieldEntry}" />
                            </VerticalStackLayout>
                            <Image Grid.Column="1" Source="eyeofficon.png" WidthRequest="22" HeightRequest="22"
                                   VerticalOptions="Center">
                                <Image.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnToggleTapped"
                                        CommandParameter="{x:Reference NewPasswordEntry}" />
                                </Image.GestureRecognizers>
                            </Image>
                        </Grid>
                        <BoxView Style="{StaticResource Divider}" />

                        <!-- Confirm new password -->
                        <Grid ColumnDefinitions="*,Auto" Padding="14,10">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="Confirm new password" Style="{StaticResource FieldLabel}" />
                                <Entry x:Name="ConfirmPasswordEntry" IsPassword="True"
                                       Placeholder="Re-enter new password"
                                       Style="{StaticResource FieldEntry}" />
                            </VerticalStackLayout>
                            <Image Grid.Column="1" Source="eyeofficon.png" WidthRequest="22" HeightRequest="22"
                                   VerticalOptions="Center">
                                <Image.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnToggleTapped"
                                        CommandParameter="{x:Reference ConfirmPasswordEntry}" />
                                </Image.GestureRecognizers>
                            </Image>
                        </Grid>

                    </VerticalStackLayout>
                </Border>

                <Label Text="Use at least 8 characters with a mix of letters, numbers and symbols. Choose a password you don't use elsewhere."
                       Style="{StaticResource HintText}" />

                <Label Text="KEEP YOUR PASSWORD PRIVATE" Style="{StaticResource CapsLabel}" Margin="0,10,0,0" />
                <Label Text="Never share your password or include it in a support message."
                       Style="{StaticResource HintText}" />

            </VerticalStackLayout>
        </ScrollView>

        <!-- Save -->
        <Button Grid.Row="2" Text="Save password" Margin="0,10,0,0"
                Style="{StaticResource PrimaryButton}" Clicked="OnSavePasswordClicked" />
    </Grid>
</ContentPage>