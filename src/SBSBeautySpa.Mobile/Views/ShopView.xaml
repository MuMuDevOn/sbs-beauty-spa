<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="SBSBeautySpa.Mobile.Views.ShopView"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
             xmlns:vm="clr-namespace:SBSBeautySpa.Mobile.ViewModels"
             xmlns:models="clr-namespace:SBSBeautySpa.Mobile.Models"
             xmlns:conv="clr-namespace:SBSBeautySpa.Mobile.Converters"
             x:DataType="vm:ShopViewModel"
             BackgroundColor="White"
             Shell.NavBarIsVisible="False">

    <!-- Shop: clean white page with black text, navy buttons, and blue as the accent.
         Colors are page-local; they can move to Resources/Styles/Styles.xaml later. -->
    <ContentPage.Resources>
        <Color x:Key="DeepNavy">#1B2A4A</Color>
        <Color x:Key="AccentBlue">#2F63E0</Color>
        <Color x:Key="InkText">#111827</Color>
        <Color x:Key="MutedGray">#8A93A6</Color>
        <Color x:Key="SoftBlue">#EEF3FD</Color>
        <Color x:Key="CardStroke">#E3E9F5</Color>

        <!-- Navy -> blue, used on buttons and the selected category -->
        <LinearGradientBrush x:Key="BlueGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#1B2A4A" Offset="0.0" />
            <GradientStop Color="#2F63E0" Offset="1.0" />
        </LinearGradientBrush>

        <conv:BoolToColorConverter x:Key="BoolToColor" />
        <conv:InvertedBoolConverter x:Key="InvertedBool" />
        <conv:IsNotNullConverter x:Key="IsNotNull" />
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,Auto,Auto,*">

        <!-- Header: title, search, cart -->
        <Grid Grid.Row="0" Padding="20,44,20,10" ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="10">
            <!-- Back arrow (your original style) -> returns to the dashboard -->
            <Image Grid.Column="0" WidthRequest="26" HeightRequest="26" VerticalOptions="Center"
                   mi:MauiIcon.Value="{mi:Material Icon=ArrowBack, IconColor=#111827}">
                <Image.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnBackTapped" />
                </Image.GestureRecognizers>
            </Image>
            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                <Label Text="Shop" FontSize="28" FontFamily="OpenSansSemibold" TextColor="{StaticResource InkText}" />
                <Label Text="Beauty essentials for home" FontSize="13" TextColor="{StaticResource MutedGray}" />
            </VerticalStackLayout>

            <!-- Purchase history button (receipt icon) -->
            <Border Grid.Column="2" WidthRequest="44" HeightRequest="44" VerticalOptions="Center"
                    BackgroundColor="{StaticResource SoftBlue}" StrokeThickness="0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="22" />
                </Border.StrokeShape>
                <Grid WidthRequest="22" HeightRequest="26" HorizontalOptions="Center" VerticalOptions="Center">
                    <Path Data="M2,1 L20,1 L20,24 L16,21 L11,24 L6,21 L2,24 Z" Stroke="{StaticResource DeepNavy}" StrokeThickness="2"
                          StrokeLineJoin="Round" />
                    <Line X1="6" Y1="8" X2="16" Y2="8" Stroke="{StaticResource DeepNavy}" StrokeThickness="2" StrokeLineCap="Round" />
                    <Line X1="6" Y1="13" X2="16" Y2="13" Stroke="{StaticResource DeepNavy}" StrokeThickness="2" StrokeLineCap="Round" />
                </Grid>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnHistoryTapped" />
                </Border.GestureRecognizers>
            </Border>

            <!-- Search button -->
            <Border Grid.Column="3" WidthRequest="44" HeightRequest="44" VerticalOptions="Center"
                    BackgroundColor="{StaticResource SoftBlue}" StrokeThickness="0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="22" />
                </Border.StrokeShape>
                <Grid WidthRequest="26" HeightRequest="26" HorizontalOptions="Center" VerticalOptions="Center">
                    <Ellipse Stroke="{StaticResource DeepNavy}" StrokeThickness="2" WidthRequest="15" HeightRequest="15"
                             HorizontalOptions="Start" VerticalOptions="Start" />
                    <Line X1="14" Y1="14" X2="23" Y2="23" Stroke="{StaticResource DeepNavy}" StrokeThickness="2" StrokeLineCap="Round"
                          HorizontalOptions="Start" VerticalOptions="Start" />
                </Grid>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding ToggleSearchCommand}" />
                </Border.GestureRecognizers>
            </Border>

            <!-- Cart button -->
            <Border Grid.Column="4" WidthRequest="44" HeightRequest="44" VerticalOptions="Center"
                    BackgroundColor="{StaticResource DeepNavy}" StrokeThickness="0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="22" />
                </Border.StrokeShape>
                <Grid WidthRequest="28" HeightRequest="26" HorizontalOptions="Center" VerticalOptions="Center">
                    <Path Data="M1,2 L5,2 L8,15 L22,15 L25,5 L6,5" Stroke="White" StrokeThickness="2"
                          StrokeLineJoin="Round" StrokeLineCap="Round" />
                    <Ellipse Fill="White" WidthRequest="4" HeightRequest="4" HorizontalOptions="Start" VerticalOptions="Start" Margin="9,19,0,0" />
                    <Ellipse Fill="White" WidthRequest="4" HeightRequest="4" HorizontalOptions="Start" VerticalOptions="Start" Margin="19,19,0,0" />
                </Grid>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnCartTapped" />
                </Border.GestureRecognizers>
            </Border>
        </Grid>

        <!-- Search box (shown when the search icon is toggled) -->
        <Border Grid.Row="1" Margin="20,0,20,10" Padding="16,0" BackgroundColor="{StaticResource SoftBlue}"
                StrokeThickness="0" IsVisible="{Binding IsSearchVisible}">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="14" />
            </Border.StrokeShape>
            <Entry Placeholder="Search products" Text="{Binding SearchText}"
                   TextColor="{StaticResource InkText}" PlaceholderColor="{StaticResource MutedGray}" />
        </Border>

        <!-- Category tabs: All | Kits | Sets ... built from real categories -->
        <CollectionView Grid.Row="2" ItemsSource="{Binding Categories}" HeightRequest="50" Margin="20,0,0,8">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Horizontal" ItemSpacing="8" />
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:SelectableTab">
                    <Border Padding="20,9" StrokeThickness="1" VerticalOptions="Center" Stroke="#E3E9F5"
                            BackgroundColor="{Binding IsSelected, Converter={StaticResource BoolToColor}, ConverterParameter='#2F63E0|White'}">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="20" />
                        </Border.StrokeShape>
                        <Label Text="{Binding Label}" FontSize="14" FontFamily="OpenSansSemibold"
                               TextColor="{Binding IsSelected, Converter={StaticResource BoolToColor}, ConverterParameter='White|#4B5563'}" />
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.SelectCategoryCommand}"
                                                  CommandParameter="{Binding .}" />
                        </Border.GestureRecognizers>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Product grid + overlays (loading / empty / error / toast) -->
        <Grid Grid.Row="3">
            <CollectionView ItemsSource="{Binding Products}" Margin="14,4,14,0">
                <CollectionView.ItemsLayout>
                    <GridItemsLayout Orientation="Vertical" Span="2" HorizontalItemSpacing="12" VerticalItemSpacing="12" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Product">
                        <Border Padding="10" BackgroundColor="White"
                                Stroke="{StaticResource CardStroke}" StrokeThickness="1">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="18" />
                            </Border.StrokeShape>
                            <Border.Shadow>
                                <Shadow Brush="#1B2A4A" Opacity="0.10" Radius="14" Offset="0,5" />
                            </Border.Shadow>
                            <VerticalStackLayout Spacing="5">

                                <!-- Image box: soft blue placeholder until there's a photo -->
                                <Border HeightRequest="120" BackgroundColor="{StaticResource SoftBlue}" StrokeThickness="0">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="12" />
                                    </Border.StrokeShape>
                                    <Grid>
                                        <Label Text="Image" FontSize="13" TextColor="{StaticResource MutedGray}"
                                               HorizontalOptions="Center" VerticalOptions="Center"
                                               IsVisible="{Binding HasImage, Converter={StaticResource InvertedBool}}" />
                                        <Image Source="{Binding ImageUrl}" Aspect="AspectFill" />
                                    </Grid>
                                </Border>

                                <Label Text="{Binding Name}" FontSize="15" FontFamily="OpenSansSemibold" TextColor="{StaticResource InkText}"
                                       MaxLines="1" LineBreakMode="TailTruncation" Margin="0,6,0,0" />
                                <Label Text="{Binding Description}" FontSize="12" TextColor="{StaticResource MutedGray}"
                                       MaxLines="1" LineBreakMode="TailTruncation" />

                                <Grid ColumnDefinitions="*,Auto" Margin="0,2,0,4">
                                    <Label Grid.Column="0" Text="{Binding PriceLabel}" FontSize="16" FontFamily="OpenSansSemibold"
                                           TextColor="{StaticResource AccentBlue}" />
                                    <!-- Rating: hidden until a product actually has one -->
                                    <Label Grid.Column="1" Text="{Binding RatingLabel, StringFormat='&#9733; {0}'}" FontSize="12"
                                           TextColor="{StaticResource InkText}" IsVisible="{Binding HasRating}" />
                                </Grid>

                                <Button Text="Add to Cart" FontSize="14" FontFamily="OpenSansSemibold" HeightRequest="42" CornerRadius="12"
                                        Background="{StaticResource BlueGradient}" TextColor="White"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.AddToCartCommand}"
                                        CommandParameter="{Binding .}" />
                                <Label Text="Out of stock" FontSize="11" TextColor="{StaticResource MutedGray}" HorizontalOptions="Center"
                                       IsVisible="{Binding IsInStock, Converter={StaticResource InvertedBool}}" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="{StaticResource AccentBlue}"
                               HorizontalOptions="Center" VerticalOptions="Center" />

            <Label Text="No products found." FontSize="15" TextColor="{StaticResource MutedGray}"
                   HorizontalOptions="Center" VerticalOptions="Center" IsVisible="{Binding IsEmpty}" />

            <Label Text="{Binding ErrorMessage}" FontSize="14" TextColor="{StaticResource MutedGray}" Margin="30,0"
                   HorizontalTextAlignment="Center" HorizontalOptions="Center" VerticalOptions="Center"
                   IsVisible="{Binding ErrorMessage, Converter={StaticResource IsNotNull}}" />

            <Border BackgroundColor="{StaticResource DeepNavy}" StrokeThickness="0" Padding="16,12" Margin="24,0,24,20"
                    VerticalOptions="End" IsVisible="{Binding ToastMessage, Converter={StaticResource IsNotNull}}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="14" />
                </Border.StrokeShape>
                <Label Text="{Binding ToastMessage}" TextColor="White" FontSize="13" HorizontalTextAlignment="Center" />
            </Border>
        </Grid>
    </Grid>
</ContentPage>
