<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="SBSBeautySpa.Mobile.Views.DeliveryAddressesPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
             xmlns:vm="clr-namespace:SBSBeautySpa.Mobile.ViewModels"
             xmlns:models="clr-namespace:SBSBeautySpa.Mobile.Models"
             xmlns:conv="clr-namespace:SBSBeautySpa.Mobile.Converters"
             x:DataType="vm:DeliveryAddressesViewModel"
             BackgroundColor="White"
             Shell.NavBarIsVisible="False">

    <ContentPage.Resources>
        <Color x:Key="DeepNavy">#1B2A4A</Color>
        <Color x:Key="AccentBlue">#2F63E0</Color>
        <Color x:Key="InkText">#111827</Color>
        <Color x:Key="MutedGray">#8A93A6</Color>
        <Color x:Key="SoftBlue">#EEF3FD</Color>
        <Color x:Key="CardStroke">#E3E9F5</Color>
        <LinearGradientBrush x:Key="BlueGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#1B2A4A" Offset="0.0" />
            <GradientStop Color="#2F63E0" Offset="1.0" />
        </LinearGradientBrush>
        <conv:InvertedBoolConverter x:Key="InvertedBool" />
        <conv:IsNotNullConverter x:Key="IsNotNull" />
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,Auto,*">
        <!-- Header: your arrow + title -->
        <Grid Grid.Row="0" Padding="20,44,20,10" ColumnDefinitions="Auto,*" ColumnSpacing="14">
            <Image Grid.Column="0" WidthRequest="26" HeightRequest="26" VerticalOptions="Center"
                   mi:MauiIcon.Value="{mi:Material Icon=ArrowBack, IconColor=#111827}">
                <Image.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnBackTapped" />
                </Image.GestureRecognizers>
            </Image>
            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                <Label Text="Delivery Addresses" FontSize="26" FontFamily="OpenSansSemibold" TextColor="{StaticResource InkText}" />
                <Label Text="Where should we send your order?" FontSize="13" TextColor="{StaticResource MutedGray}" />
            </VerticalStackLayout>
        </Grid>

        <!-- Steps -->
        <Grid Grid.Row="1" ColumnDefinitions="*,*,*" ColumnSpacing="8" Margin="20,0,20,12">
            <Border Grid.Column="0" Padding="0,9" BackgroundColor="{StaticResource AccentBlue}" StrokeThickness="0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>
                <Label Text="DELIVERY" FontSize="11" FontFamily="OpenSansSemibold" TextColor="White" HorizontalOptions="Center" />
            </Border>
            <Border Grid.Column="1" Padding="0,9" BackgroundColor="{StaticResource SoftBlue}" StrokeThickness="0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>
                <Label Text="PAYMENT" FontSize="11" FontFamily="OpenSansSemibold" TextColor="{StaticResource MutedGray}" HorizontalOptions="Center" />
            </Border>
            <Border Grid.Column="2" Padding="0,9" BackgroundColor="{StaticResource SoftBlue}" StrokeThickness="0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>
                <Label Text="CONFIRMATION" FontSize="11" FontFamily="OpenSansSemibold" TextColor="{StaticResource MutedGray}" HorizontalOptions="Center" />
            </Border>
        </Grid>

        <ScrollView Grid.Row="2">
            <VerticalStackLayout Padding="16,0,16,24" Spacing="14">

                <!-- Add new -->
                <Border Padding="16,14" BackgroundColor="{StaticResource SoftBlue}" StrokeThickness="0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16" />
                    </Border.StrokeShape>
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="New Delivery Address" FontSize="15" FontFamily="OpenSansSemibold" TextColor="{StaticResource InkText}" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="Add" FontSize="15" FontFamily="OpenSansSemibold" TextColor="{StaticResource AccentBlue}" VerticalOptions="Center" />
                    </Grid>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding AddCommand}" />
                    </Border.GestureRecognizers>
                </Border>

                <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="{StaticResource AccentBlue}" />

                <Label Text="{Binding ErrorMessage}" FontSize="13" TextColor="#B3261E" HorizontalTextAlignment="Center"
                       IsVisible="{Binding ErrorMessage, Converter={StaticResource IsNotNull}}" />

                <VerticalStackLayout Spacing="12" BindableLayout.ItemsSource="{Binding Addresses}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="models:CheckoutAddress">
                            <Border Padding="16" BackgroundColor="White" Stroke="{StaticResource CardStroke}" StrokeThickness="1">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="18" />
                                </Border.StrokeShape>
                                <Border.Shadow>
                                    <Shadow Brush="#1B2A4A" Opacity="0.10" Radius="14" Offset="0,5" />
                                </Border.Shadow>
                                <VerticalStackLayout Spacing="8">
                                    <Label Text="{Binding RecipientName}" FontSize="17" FontFamily="OpenSansSemibold" TextColor="{StaticResource InkText}" />
                                    <Border Padding="10,3" BackgroundColor="{StaticResource SoftBlue}" StrokeThickness="0" HorizontalOptions="Start">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="10" />
                                        </Border.StrokeShape>
                                        <Label Text="{Binding TypeLabel}" FontSize="11" FontFamily="OpenSansSemibold" TextColor="{StaticResource AccentBlue}" />
                                    </Border>
                                    <Label Text="{Binding AddressLine}" FontSize="14" TextColor="{StaticResource InkText}" />
                                    <Label Text="{Binding Phone}" FontSize="13" TextColor="{StaticResource MutedGray}" />

                                    <Button Text="Deliver to this address" FontFamily="OpenSansSemibold" FontSize="14" HeightRequest="46" CornerRadius="14"
                                            Background="{StaticResource BlueGradient}" TextColor="White" Margin="0,4,0,0"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.DeliverHereCommand}"
                                            CommandParameter="{Binding .}" />

                                    <HorizontalStackLayout Spacing="22">
                                        <Label Text="Edit" FontSize="14" FontFamily="OpenSansSemibold" TextColor="{StaticResource AccentBlue}">
                                            <Label.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.EditCommand}"
                                                                      CommandParameter="{Binding .}" />
                                            </Label.GestureRecognizers>
                                        </Label>
                                        <Label Text="Delete" FontSize="14" FontFamily="OpenSansSemibold" TextColor="#B3261E">
                                            <Label.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.DeleteCommand}"
                                                                      CommandParameter="{Binding .}" />
                                            </Label.GestureRecognizers>
                                        </Label>
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <Label Text="No saved addresses yet. Tap Add to enter one." FontSize="14" TextColor="{StaticResource MutedGray}"
                       HorizontalOptions="Center" Margin="0,24,0,0" IsVisible="{Binding HasNoAddresses}" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
