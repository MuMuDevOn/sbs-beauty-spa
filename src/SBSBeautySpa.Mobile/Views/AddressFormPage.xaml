<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="SBSBeautySpa.Mobile.Views.AddressFormPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
             xmlns:vm="clr-namespace:SBSBeautySpa.Mobile.ViewModels"
             xmlns:models="clr-namespace:SBSBeautySpa.Mobile.Models"
             xmlns:svc="clr-namespace:SBSBeautySpa.Mobile.Services"
             xmlns:conv="clr-namespace:SBSBeautySpa.Mobile.Converters"
             x:DataType="vm:AddressFormViewModel"
             BackgroundColor="White"
             Shell.NavBarIsVisible="False">

    <ContentPage.Resources>
        <Color x:Key="DeepNavy">#1B2A4A</Color>
        <Color x:Key="AccentBlue">#2F63E0</Color>
        <Color x:Key="InkText">#111827</Color>
        <Color x:Key="MutedGray">#8A93A6</Color>
        <Color x:Key="SoftBlue">#EEF3FD</Color>
        <Color x:Key="CardStroke">#E3E9F5</Color>
        <LinearGradientBrush x:Key="BlueGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#1B2A4A" Offset="0.0" />
            <GradientStop Color="#2F63E0" Offset="1.0" />
        </LinearGradientBrush>
        <conv:InvertedBoolConverter x:Key="InvertedBool" />
        <conv:IsNotNullConverter x:Key="IsNotNull" />
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*,Auto">

        <Grid Grid.Row="0" Padding="20,44,20,10" ColumnDefinitions="Auto,*" ColumnSpacing="14">
            <Image Grid.Column="0" WidthRequest="26" HeightRequest="26" VerticalOptions="Center"
                   mi:MauiIcon.Value="{mi:Material Icon=ArrowBack, IconColor=#111827}">
                <Image.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnBackTapped" />
                </Image.GestureRecognizers>
            </Image>
            <Label Grid.Column="1" Text="{Binding PageTitle}" FontSize="26" FontFamily="OpenSansSemibold" TextColor="{StaticResource InkText}" VerticalOptions="Center" />
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20,4,20,20" Spacing="14">

                <!-- Address search (Google Places): pick a suggestion and the boxes below fill in -->
                <VerticalStackLayout Spacing="6">
                    <Label Text="Find your address" FontSize="13" FontFamily="OpenSansSemibold" TextColor="{StaticResource InkText}" />
                    <Border Padding="14,0" BackgroundColor="{StaticResource SoftBlue}" StrokeThickness="0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14" />
                        </Border.StrokeShape>
                        <Entry Text="{Binding AddressSearch}" Placeholder="Start typing your street address" TextColor="{StaticResource InkText}" PlaceholderColor="{StaticResource MutedGray}" />
                    </Border>

                    <Border IsVisible="{Binding HasSuggestions}" Padding="0" BackgroundColor="White" Stroke="{StaticResource CardStroke}" StrokeThickness="1">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14" />
                        </Border.StrokeShape>
                        <VerticalStackLayout Spacing="0">
                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Suggestions}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="svc:PlaceSuggestion">
                                        <VerticalStackLayout Padding="14,10" Spacing="1">
                                            <Label Text="{Binding MainText}" FontSize="14" FontFamily="OpenSansSemibold" TextColor="{StaticResource InkText}" />
                                            <Label Text="{Binding SecondaryText}" FontSize="12" TextColor="{StaticResource MutedGray}" />
                                            <VerticalStackLayout.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.SelectSuggestionCommand}"
                                                                      CommandParameter="{Binding .}" />
                                            </VerticalStackLayout.GestureRecognizers>
                                        </VerticalStackLayout>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                            <Label Text="Powered by Google" FontSize="10" TextColor="{StaticResource MutedGray}" HorizontalOptions="End" Margin="0,2,12,8" />
                        </VerticalStackLayout>
                    </Border>

                    <Label Text="{Binding SearchMessage}" FontSize="12" TextColor="{StaticResource MutedGray}"
                           IsVisible="{Binding SearchMessage, Converter={StaticResource IsNotNull}}" />
                    <Label Text="Or fill in the details below yourself." FontSize="12" TextColor="{StaticResource MutedGray}" />
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="6">
                    <Label Text="Recipient name" FontSize="13" FontFamily="OpenSansSemibold" TextColor="{StaticResource InkText}" />
                    <Border Padding="14,0" BackgroundColor="{StaticResource SoftBlue}" StrokeThickness="0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14" />
                        </Border.StrokeShape>
                        <Entry Text="{Binding RecipientName}" Placeholder="Who is receiving the parcel?" TextColor="{StaticResource InkText}" PlaceholderColor="{StaticResource MutedGray}" />
                    </Border>
                </VerticalStackLayout>
                <VerticalStackLayout Spacing="6">
                    <Label Text="Phone number" FontSize="13" FontFamily="OpenSansSemibold" TextColor="{StaticResource InkText}" />
                    <Border Padding="14,0" BackgroundColor="{StaticResource SoftBlue}" StrokeThickness="0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14" />
                        </Border.StrokeShape>
                        <Entry Text="{Binding Phone}" Placeholder="e.g. 0821234567" Keyboard="Telephone" TextColor="{StaticResource InkText}" PlaceholderColor="{StaticResource MutedGray}" />
                    </Border>
                </VerticalStackLayout>
                <VerticalStackLayout Spacing="6">
                    <Label Text="Address type" FontSize="13" FontFamily="OpenSansSemibold" TextColor="{StaticResource InkText}" />
                    <Border Padding="14,0" BackgroundColor="{StaticResource SoftBlue}" StrokeThickness="0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14" />
                        </Border.StrokeShape>
                        <Picker ItemsSource="{Binding AddressTypes}" SelectedItem="{Binding SelectedType}" TextColor="{StaticResource InkText}" TitleColor="{StaticResource MutedGray}" />
                    </Border>
                </VerticalStackLayout>
                <VerticalStackLayout Spacing="6">
                    <Label Text="Complex / building (optional)" FontSize="13" FontFamily="OpenSansSemibold" TextColor="{StaticResource InkText}" />
                    <Border Padding="14,0" BackgroundColor="{StaticResource SoftBlue}" StrokeThickness="0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14" />
                        </Border.StrokeShape>
                        <Entry Text="{Binding Complex}" Placeholder="e.g. Unit 4, Palm Court" TextColor="{StaticResource InkText}" PlaceholderColor="{StaticResource MutedGray}" />
                    </Border>
                </VerticalStackLayout>
                <VerticalStackLayout Spacing="6">
                    <Label Text="Street address" FontSize="13" FontFamily="OpenSansSemibold" TextColor="{StaticResource InkText}" />
                    <Border Padding="14,0" BackgroundColor="{StaticResource SoftBlue}" StrokeThickness="0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14" />
                        </Border.StrokeShape>
                        <Entry Text="{Binding StreetAddress}" Placeholder="e.g. 44 Alsatian Road" TextColor="{StaticResource InkText}" PlaceholderColor="{StaticResource MutedGray}" />
                    </Border>
                </VerticalStackLayout>
                <VerticalStackLayout Spacing="6">
                    <Label Text="Suburb" FontSize="13" FontFamily="OpenSansSemibold" TextColor="{StaticResource InkText}" />
                    <Border Padding="14,0" BackgroundColor="{StaticResource SoftBlue}" StrokeThickness="0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14" />
                        </Border.StrokeShape>
                        <Entry Text="{Binding Suburb}" Placeholder="" TextColor="{StaticResource InkText}" PlaceholderColor="{StaticResource MutedGray}" />
                    </Border>
                </VerticalStackLayout>
                <VerticalStackLayout Spacing="6">
                    <Label Text="City / town" FontSize="13" FontFamily="OpenSansSemibold" TextColor="{StaticResource InkText}" />
                    <Border Padding="14,0" BackgroundColor="{StaticResource SoftBlue}" StrokeThickness="0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14" />
                        </Border.StrokeShape>
                        <Entry Text="{Binding City}" Placeholder="" TextColor="{StaticResource InkText}" PlaceholderColor="{StaticResource MutedGray}" />
                    </Border>
                </VerticalStackLayout>
                <VerticalStackLayout Spacing="6">
                    <Label Text="Province" FontSize="13" FontFamily="OpenSansSemibold" TextColor="{StaticResource InkText}" />
                    <Border Padding="14,0" BackgroundColor="{StaticResource SoftBlue}" StrokeThickness="0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14" />
                        </Border.StrokeShape>
                        <Picker ItemsSource="{Binding Provinces}" SelectedItem="{Binding SelectedProvince}" Title="Choose a province" TextColor="{StaticResource InkText}" TitleColor="{StaticResource MutedGray}" />
                    </Border>
                </VerticalStackLayout>
                <VerticalStackLayout Spacing="6">
                    <Label Text="Postal code" FontSize="13" FontFamily="OpenSansSemibold" TextColor="{StaticResource InkText}" />
                    <Border Padding="14,0" BackgroundColor="{StaticResource SoftBlue}" StrokeThickness="0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14" />
                        </Border.StrokeShape>
                        <Entry Text="{Binding PostalCode}" Placeholder="4 digits" Keyboard="Numeric" TextColor="{StaticResource InkText}" PlaceholderColor="{StaticResource MutedGray}" />
                    </Border>
                </VerticalStackLayout>

                <Label Text="{Binding ErrorMessage}" FontSize="13" TextColor="#B3261E" HorizontalTextAlignment="Center"
                       IsVisible="{Binding ErrorMessage, Converter={StaticResource IsNotNull}}" />
            </VerticalStackLayout>
        </ScrollView>

        <VerticalStackLayout Grid.Row="2" Padding="16,10,16,18" BackgroundColor="White">
            <Button Text="Save address" FontFamily="OpenSansSemibold" FontSize="16" HeightRequest="54" CornerRadius="16"
                    Background="{StaticResource BlueGradient}" TextColor="White"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBool}}"
                    Command="{Binding SaveCommand}" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
