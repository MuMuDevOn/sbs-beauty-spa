<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SBSBeautySpa.Mobile.Views.PaymentMethodsPage"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*,Auto" Padding="20,50,20,16"
          Background="{StaticResource PageGradient}">

        <!-- Header: Back arrow + page title -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*" ColumnSpacing="14">
            <Label Text="←" FontSize="28" TextColor="White" VerticalOptions="Center">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnBackTapped" />
                </Label.GestureRecognizers>
            </Label>
            <Label Grid.Column="1" Text="Payment Methods" Style="{StaticResource PageTitle}" />
        </Grid>

        <!-- Content -->
        <ScrollView Grid.Row="1" Margin="0,24,0,0">
            <VerticalStackLayout Spacing="10">

                <Label Text="View and manage the payment methods saved to your account."
                       Style="{StaticResource HintText}" />

                <Label Text="SAVED PAYMENT METHODS" Style="{StaticResource CapsLabel}" Margin="0,6,0,0" />

                <!-- Empty state card (hide when saved methods exist) -->
                <Border x:Name="EmptyState" Style="{StaticResource GroupCard}">
                    <VerticalStackLayout Padding="20,28" Spacing="8">

                        <Border WidthRequest="56" HeightRequest="56" HorizontalOptions="Center"
                                BackgroundColor="{StaticResource Placeholder}"
                                StrokeThickness="0" StrokeShape="RoundRectangle 28">
                            <Image Source="creditcardicon.png"
                                   WidthRequest="26" HeightRequest="26"
                                   Aspect="AspectFit"
                                   HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>

                        <Label Text="No saved payment methods" Margin="0,6,0,0"
                               Style="{StaticResource RowTitle}" HorizontalOptions="Center" />

                        <Label Text="You haven't added a payment method yet. Add one to keep it available for future bookings."
                               Style="{StaticResource RowSubtitle}"
                               HorizontalTextAlignment="Center" />

                    </VerticalStackLayout>
                </Border>

                <Label Text="Your saved methods will appear here after you add them."
                       Style="{StaticResource HintText}" />

            </VerticalStackLayout>
        </ScrollView>

        <!-- Add -->
        <Button Grid.Row="2" Text="Add payment method" Margin="0,10,0,0"
                Style="{StaticResource PrimaryButton}" Clicked="OnAddPaymentClicked" />
    </Grid>
</ContentPage>