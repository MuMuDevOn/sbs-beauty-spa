<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
             x:Class="SBSBeautySpa.Mobile.Views.PaymentMethodsPage"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*" Padding="20,50,20,16"
          Background="{StaticResource PageGradient}">

        <!-- Header: Back arrow + page title -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*" ColumnSpacing="14">
            <Image WidthRequest="26" HeightRequest="26" VerticalOptions="Center"
                   mi:MauiIcon.Value="{mi:Material Icon=ArrowBack, IconColor=White}">
                <Image.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnBackTapped" />
                </Image.GestureRecognizers>
            </Image>
            <Label Grid.Column="1" Text="Payment Methods" Style="{StaticResource PageTitle}" />
        </Grid>

        <!-- Content -->
        <ScrollView Grid.Row="1" Margin="0,24,0,0">
            <VerticalStackLayout Spacing="10">

                <Label Text="How payments work in SBS Beauty Spa."
                       Style="{StaticResource HintText}" />

                <Label Text="SECURE PAYMENTS" Style="{StaticResource CapsLabel}" Margin="0,6,0,0" />

                <!-- Paystack info card -->
                <Border x:Name="EmptyState" Style="{StaticResource GroupCard}">
                    <VerticalStackLayout Padding="20,28" Spacing="8">

                        <Border WidthRequest="56" HeightRequest="56" HorizontalOptions="Center"
                                BackgroundColor="{StaticResource Placeholder}"
                                StrokeThickness="0" StrokeShape="RoundRectangle 28">
                            <Image Source="creditcardicon.png"
                                   WidthRequest="26" HeightRequest="26"
                                   Aspect="AspectFit"
                                   HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>

                        <Label Text="Paid securely with Paystack" Margin="0,6,0,0"
                               Style="{StaticResource RowTitle}" HorizontalOptions="Center" />

                        <Label Text="When you pay for a booking or a shop order, you'll be taken to Paystack's secure payment page to enter your payment details."
                               Style="{StaticResource RowSubtitle}"
                               HorizontalTextAlignment="Center" />

                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource GroupCard}">
                    <VerticalStackLayout Padding="20,18" Spacing="6">
                        <Label Text="Your card details are never saved" Style="{StaticResource RowTitle}" />
                        <Label Text="SBS Beauty Spa never sees or stores your card number. You enter your details on Paystack each time you pay."
                               Style="{StaticResource RowSubtitle}" />
                    </VerticalStackLayout>
                </Border>

                <Label Text="Need a receipt? Open the Shop and tap the receipt icon to see your purchase history and invoices."
                       Style="{StaticResource HintText}" />

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
