<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="SBSBeautySpa.Mobile.Views.CartView"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
             xmlns:vm="clr-namespace:SBSBeautySpa.Mobile.ViewModels"
             xmlns:conv="clr-namespace:SBSBeautySpa.Mobile.Converters"
             x:DataType="vm:CartViewModel"
             BackgroundColor="White"
             Shell.NavBarIsVisible="False">

    <!-- Cart: same black / white / blue look as the Shop page. -->
    <ContentPage.Resources>
        <Color x:Key="DeepNavy">#1B2A4A</Color>
        <Color x:Key="AccentBlue">#2F63E0</Color>
        <Color x:Key="InkText">#111827</Color>
        <Color x:Key="MutedGray">#8A93A6</Color>
        <Color x:Key="SoftBlue">#EEF3FD</Color>
        <Color x:Key="CardStroke">#E3E9F5</Color>

        <LinearGradientBrush x:Key="BlueGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#1B2A4A" Offset="0.0" />
            <GradientStop Color="#2F63E0" Offset="1.0" />
        </LinearGradientBrush>

        <conv:InvertedBoolConverter x:Key="InvertedBool" />
        <conv:IsNotNullConverter x:Key="IsNotNull" />

        <!-- Round - / + buttons -->
        <Style x:Key="StepperButton" TargetType="Button">
            <Setter Property="WidthRequest" Value="34" />
            <Setter Property="HeightRequest" Value="34" />
            <Setter Property="CornerRadius" Value="17" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontFamily" Value="OpenSansSemibold" />
            <Setter Property="BackgroundColor" Value="#EEF3FD" />
            <Setter Property="TextColor" Value="#2F63E0" />
        </Style>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Header: your arrow + title -->
        <Grid Grid.Row="0" Padding="20,44,20,10" ColumnDefinitions="Auto,*" ColumnSpacing="14">
            <Image Grid.Column="0" WidthRequest="26" HeightRequest="26" VerticalOptions="Center"
                   mi:MauiIcon.Value="{mi:Material Icon=ArrowBack, IconColor=#111827}">
                <Image.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnBackTapped" />
                </Image.GestureRecognizers>
            </Image>
            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                <Label Text="Cart" FontSize="28" FontFamily="OpenSansSemibold" TextColor="{StaticResource InkText}" />
                <Label Text="Review your items" FontSize="13" TextColor="{StaticResource MutedGray}" />
            </VerticalStackLayout>
        </Grid>

        <!-- Items + summary -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16,8,16,16" Spacing="14">

                <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="{StaticResource AccentBlue}" />

                <!-- BindableLayout (not a CollectionView) because the page already scrolls as a whole. -->
                <VerticalStackLayout Spacing="12" BindableLayout.ItemsSource="{Binding Lines}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:CartLine">
                            <Border Padding="12" BackgroundColor="White"
                                    Stroke="{StaticResource CardStroke}" StrokeThickness="1">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="18" />
                                </Border.StrokeShape>
                                <Border.Shadow>
                                    <Shadow Brush="#1B2A4A" Opacity="0.10" Radius="14" Offset="0,5" />
                                </Border.Shadow>
                                <Grid ColumnDefinitions="64,*,Auto" ColumnSpacing="12">

                                    <Border Grid.Column="0" WidthRequest="64" HeightRequest="64" VerticalOptions="Start"
                                            BackgroundColor="{StaticResource SoftBlue}" StrokeThickness="0">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="12" />
                                        </Border.StrokeShape>
                                        <Grid>
                                            <Label Text="Image" FontSize="11" TextColor="{StaticResource MutedGray}"
                                                   HorizontalOptions="Center" VerticalOptions="Center"
                                                   IsVisible="{Binding HasImage, Converter={StaticResource InvertedBool}}" />
                                            <Image Source="{Binding ImageUrl}" Aspect="AspectFill" />
                                        </Grid>
                                    </Border>

                                    <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                                        <Label Text="{Binding Name}" FontSize="15" FontFamily="OpenSansSemibold" TextColor="{StaticResource InkText}"
                                               MaxLines="2" LineBreakMode="TailTruncation" />
                                        <Label Text="{Binding UnitPriceLabel}" FontSize="15" FontFamily="OpenSansSemibold" TextColor="{StaticResource AccentBlue}" />
                                        <Label Text="No longer available" FontSize="12" TextColor="#B3261E"
                                               IsVisible="{Binding IsAvailable, Converter={StaticResource InvertedBool}}" />
                                        <Label Text="Remove" FontSize="12" TextColor="{StaticResource MutedGray}" TextDecorations="Underline">
                                            <Label.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.RemoveCommand}"
                                                                       CommandParameter="{Binding .}" />
                                            </Label.GestureRecognizers>
                                        </Label>
                                    </VerticalStackLayout>

                                    <HorizontalStackLayout Grid.Column="2" Spacing="10" VerticalOptions="Center">
                                        <Button Text="-" Style="{StaticResource StepperButton}"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.DecreaseCommand}"
                                                CommandParameter="{Binding .}" />
                                        <Label Text="{Binding Quantity}" FontSize="15" FontFamily="OpenSansSemibold" TextColor="{StaticResource InkText}"
                                               VerticalOptions="Center" WidthRequest="20" HorizontalTextAlignment="Center" />
                                        <Button Text="+" Style="{StaticResource StepperButton}"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.IncreaseCommand}"
                                                CommandParameter="{Binding .}" />
                                    </HorizontalStackLayout>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <Label Text="Your cart is empty." FontSize="15" TextColor="{StaticResource MutedGray}"
                       HorizontalOptions="Center" Margin="0,40,0,0">
                    <Label.Triggers>
                        <DataTrigger TargetType="Label" Binding="{Binding IsEmpty}" Value="False">
                            <Setter Property="IsVisible" Value="False" />
                        </DataTrigger>
                    </Label.Triggers>
                </Label>

                <!-- Order Summary — hidden when the cart is empty -->
                <VerticalStackLayout Spacing="10" Margin="0,8,0,0" IsVisible="{Binding IsEmpty, Converter={StaticResource InvertedBool}}">
                    <Label Text="Order Summary" FontSize="18" FontFamily="OpenSansSemibold" TextColor="{StaticResource InkText}" />
                    <Border Padding="18" BackgroundColor="{StaticResource SoftBlue}" StrokeThickness="0">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="18" />
                        </Border.StrokeShape>
                        <VerticalStackLayout Spacing="10">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Grid.Column="0" Text="Subtotal" FontSize="15" TextColor="#4B5563" />
                                <Label Grid.Column="1" Text="{Binding SubtotalLabel}" FontSize="15" FontFamily="OpenSansSemibold" TextColor="{StaticResource InkText}" />
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Grid.Column="0" Text="Shipping" FontSize="15" TextColor="#4B5563" />
                                <Label Grid.Column="1" Text="{Binding ShippingLabel}" FontSize="15" FontFamily="OpenSansSemibold" TextColor="{StaticResource InkText}" />
                            </Grid>
                            <BoxView HeightRequest="1" Color="#D5DEF2" />
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Grid.Column="0" Text="Total" FontSize="17" FontFamily="OpenSansSemibold" TextColor="{StaticResource InkText}" />
                                <Label Grid.Column="1" Text="{Binding TotalLabel}" FontSize="19" FontFamily="OpenSansSemibold" TextColor="{StaticResource AccentBlue}" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <Label Text="{Binding ErrorMessage}" FontSize="13" TextColor="#B3261E" HorizontalTextAlignment="Center"
                       IsVisible="{Binding ErrorMessage, Converter={StaticResource IsNotNull}}" />
            </VerticalStackLayout>
        </ScrollView>

        <!-- Footer actions -->
        <VerticalStackLayout Grid.Row="2" Padding="16,10,16,18" Spacing="10" BackgroundColor="White">
            <Button Text="Proceed to Checkout" FontFamily="OpenSansSemibold" FontSize="16" HeightRequest="54" CornerRadius="16"
                    Background="{StaticResource BlueGradient}" TextColor="White"
                    IsEnabled="{Binding IsEmpty, Converter={StaticResource InvertedBool}}"
                    Clicked="OnCheckoutClicked" />
            <Button Text="Continue Shopping" FontFamily="OpenSansSemibold" FontSize="16" HeightRequest="54" CornerRadius="16"
                    BackgroundColor="White" TextColor="{StaticResource DeepNavy}"
                    BorderColor="{StaticResource CardStroke}" BorderWidth="1.5"
                    Clicked="OnContinueShoppingClicked" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
