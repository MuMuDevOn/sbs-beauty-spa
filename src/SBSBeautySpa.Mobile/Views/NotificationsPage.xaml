<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SBSBeautySpa.Mobile.Views.NotificationsPage"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*" Padding="20,50,20,16"
          Background="{StaticResource PageGradient}">

        <!-- Header: Back arrow + page title -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*" ColumnSpacing="14">
            <Label Text="←" FontSize="28" TextColor="White" VerticalOptions="Center">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnBackTapped" />
                </Label.GestureRecognizers>
            </Label>
            <Label Grid.Column="1" Text="Notifications" Style="{StaticResource PageTitle}" />
        </Grid>

        <!-- Content -->
        <ScrollView Grid.Row="1" Margin="0,24,0,0">
            <VerticalStackLayout Spacing="10">

                <Label Text="Choose the notifications you'd like to receive."
                       Style="{StaticResource HintText}" />

                <!-- Booking updates -->
                <Label Text="BOOKING UPDATES" Style="{StaticResource CapsLabel}" Margin="0,6,0,0" />
                <Border Style="{StaticResource GroupCard}">
                    <VerticalStackLayout>

                        <Grid ColumnDefinitions="*,Auto" Padding="14,12">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="Booking confirmations" Style="{StaticResource RowTitle}" />
                                <Label Text="Confirmation when a booking is made."
                                       Style="{StaticResource RowSubtitle}" />
                            </VerticalStackLayout>
                            <Switch x:Name="BookingConfirmationsSwitch" Grid.Column="1"
                                    AutomationId="BookingConfirmations"
                                    IsToggled="True" Style="{StaticResource AppSwitch}"
                                    Toggled="OnSwitchToggled" />
                        </Grid>
                        <BoxView Style="{StaticResource Divider}" />

                        <Grid ColumnDefinitions="*,Auto" Padding="14,12">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="Booking changes" Style="{StaticResource RowTitle}" />
                                <Label Text="Updates to your booking or cancellation."
                                       Style="{StaticResource RowSubtitle}" />
                            </VerticalStackLayout>
                            <Switch x:Name="BookingChangesSwitch" Grid.Column="1"
                                    AutomationId="BookingChanges"
                                    IsToggled="True" Style="{StaticResource AppSwitch}"
                                    Toggled="OnSwitchToggled" />
                        </Grid>

                    </VerticalStackLayout>
                </Border>

                <!-- Reminders -->
                <Label Text="REMINDERS" Style="{StaticResource CapsLabel}" Margin="0,10,0,0" />
                <Border Style="{StaticResource GroupCard}">
                    <Grid ColumnDefinitions="*,Auto" Padding="14,12">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="Appointment reminders" Style="{StaticResource RowTitle}" />
                            <Label Text="A reminder before your upcoming service."
                                   Style="{StaticResource RowSubtitle}" />
                        </VerticalStackLayout>
                        <Switch x:Name="AppointmentRemindersSwitch" Grid.Column="1"
                                AutomationId="AppointmentReminders"
                                IsToggled="True" Style="{StaticResource AppSwitch}"
                                Toggled="OnSwitchToggled" />
                    </Grid>
                </Border>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>