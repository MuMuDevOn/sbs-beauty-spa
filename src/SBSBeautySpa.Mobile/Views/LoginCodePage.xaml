<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
             xmlns:vm="clr-namespace:SBSBeautySpa.Mobile.ViewModels"
             x:Class="SBSBeautySpa.Mobile.Views.LoginCodePage"
             x:DataType="vm:LoginCodeViewModel"
             Shell.NavBarIsVisible="False">

    <!-- Same purple / blue / white theme as the Login and Sign Up pages -->
    <Grid Background="{StaticResource PageGradient}">
        <ScrollView>
            <VerticalStackLayout x:Name="ContentColumn" Padding="24,50,24,30" Spacing="0"
                                 HorizontalOptions="Center">

                <!-- Back arrow (same icon as the admin pages) -->
                <Image WidthRequest="26" HeightRequest="26" HorizontalOptions="Start"
                       mi:MauiIcon.Value="{mi:Material Icon=ArrowBack, IconColor=White}">
                    <Image.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding BackCommand}" />
                    </Image.GestureRecognizers>
                </Image>

                <Image Source="logo.png" HeightRequest="110" WidthRequest="200"
                       Aspect="AspectFit" HorizontalOptions="Center" Margin="0,4,0,16" />

                <Border BackgroundColor="White" StrokeThickness="0" StrokeShape="RoundRectangle 26"
                        Padding="24,28,24,28">
                    <Border.Shadow>
                        <Shadow Brush="Black" Opacity="0.22" Radius="16" Offset="0,6" />
                    </Border.Shadow>
                    <VerticalStackLayout Spacing="0">

                        <Label Text="Check your email" FontFamily="OpenSansSemibold" FontSize="24"
                               TextColor="#2B1B6B" HorizontalOptions="Center" />
                        <Label Text="{Binding EmailText}" FontSize="14" FontFamily="OpenSansRegular"
                               TextColor="#6E63A6" Margin="0,6,0,12" HorizontalTextAlignment="Center" />

                        <!-- Tip: the code email sometimes lands in spam -->
                        <Border BackgroundColor="#F4F0FF" Stroke="Transparent" StrokeThickness="0"
                                StrokeShape="RoundRectangle 12" Padding="12,10" Margin="0,0,0,18">
                            <Label FontSize="13" FontFamily="OpenSansRegular" TextColor="#6E63A6"
                                   HorizontalTextAlignment="Center"
                                   Text="Can't find it? Check your Spam or Junk folder, and mark the email as &quot;Not spam&quot;. It can take a minute to arrive." />
                        </Border>
                        <Border BackgroundColor="#EFE9FF" Stroke="Transparent" StrokeThickness="0"
                                StrokeShape="RoundRectangle 14" Margin="0,0,0,16" Padding="14,0" HeightRequest="60">
                            <Entry Text="{Binding Code}" Keyboard="Numeric" MaxLength="6"
                                   Placeholder="000000" PlaceholderColor="#C4BCE3"
                                   TextColor="#2B1B6B" BackgroundColor="Transparent"
                                   FontFamily="OpenSansSemibold" FontSize="28"
                                   HorizontalTextAlignment="Center" VerticalOptions="Center"
                                   ReturnType="Done" ReturnCommand="{Binding VerifyCommand}" />
                        </Border>

                        <Label Text="{Binding ErrorMessage}" TextColor="#D92D20" FontSize="13" Margin="0,0,0,10"
                               HorizontalTextAlignment="Center"
                               IsVisible="{Binding ErrorMessage, Converter={StaticResource IsNotNull}}" />
                        <Label Text="{Binding InfoMessage}" TextColor="#1E7B3A" FontSize="13" Margin="0,0,0,10"
                               HorizontalTextAlignment="Center"
                               IsVisible="{Binding InfoMessage, Converter={StaticResource IsNotNull}}" />
                        <Border Background="{StaticResource NavyButtonGradient}" StrokeThickness="0"
                                StrokeShape="RoundRectangle 26" HeightRequest="52" Margin="0,6,0,0">
                            <Button Text="Verify and log in" BackgroundColor="Transparent" TextColor="White"
                                    FontFamily="OpenSansSemibold" FontSize="16"
                                    Command="{Binding VerifyCommand}" />
                        </Border>
                        <Label Text="{Binding ResendText}" TextColor="#6D3FE0" FontFamily="OpenSansSemibold" FontSize="14"
                               HorizontalOptions="Center" Margin="0,18,0,0">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ResendCommand}" />
                            </Label.GestureRecognizers>
                        </Label>

                        <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"
                                           Color="#6D3FE0" HorizontalOptions="Center" Margin="0,12,0,0" />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
