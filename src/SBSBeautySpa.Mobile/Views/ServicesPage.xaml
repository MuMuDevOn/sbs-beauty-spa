<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
             xmlns:vm="clr-namespace:SBSBeautySpa.Mobile.ViewModels"
             x:Class="SBSBeautySpa.Mobile.Views.ServicesPage"
             x:DataType="vm:ServicesViewModel"
             Shell.NavBarIsVisible="False">

    <Grid Padding="24,60,24,20" RowDefinitions="Auto,Auto,Auto,Auto,*">

        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#111827" Offset="0.00"/>
                <GradientStop Color="#1B2A4A" Offset="0.07"/>
                <GradientStop Color="#4D6893" Offset="0.34"/>
                <GradientStop Color="#7C93C4" Offset="0.74"/>
                <GradientStop Color="#9FBCE5" Offset="0.95"/>
            </LinearGradientBrush>
        </Grid.Background>

        <!-- Header -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*" ColumnSpacing="14">
            <Image Grid.Column="0" WidthRequest="28" HeightRequest="28"
                   mi:MauiIcon.Value="{mi:Material Icon=ArrowBack, IconColor=White}">
                <Image.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnBackTapped"/>
                </Image.GestureRecognizers>
            </Image>

            <Label Grid.Column="1" Text="Services"
                   FontSize="28" FontAttributes="Bold"
                   TextColor="White" VerticalOptions="Center"/>
        </Grid>

        <!-- Search -->
        <Border Grid.Row="1" Margin="0,16,0,0"
                BackgroundColor="#E6EBF4" StrokeThickness="0"
                StrokeShape="RoundRectangle 22" Padding="14,0">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" HeightRequest="46">
                <Image Grid.Column="0" WidthRequest="20" HeightRequest="20"
                       VerticalOptions="Center"
                       mi:MauiIcon.Value="{mi:Material Icon=Search, IconColor=#4D6893}"/>
                <Entry Grid.Column="1"
                       Placeholder="Search services..."
                       PlaceholderColor="#4D6893"
                       TextColor="#1B2A4A"
                       BackgroundColor="Transparent"
                       VerticalOptions="Center"
                       Text="{Binding SearchText}"/>
            </Grid>
        </Border>

        <!-- Category chips -->
        <CollectionView Grid.Row="2" Margin="0,16,0,12" HeightRequest="48"
                        ItemsSource="{Binding Categories}"
                        ItemsLayout="HorizontalList">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:ServiceCategoryTab">
                    <Border BackgroundColor="{Binding ChipBackground}"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 22"
                            Padding="18,8" Margin="0,0,8,0">
                        <Label Text="{Binding Label}"
                               FontSize="16"
                               TextColor="{Binding ChipTextColor}"
                               VerticalOptions="Center"/>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnCategoryTapped"/>
                        </Border.GestureRecognizers>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Loading / error -->
        <VerticalStackLayout Grid.Row="3">
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"
                               Color="White" HorizontalOptions="Center"/>
            <Label Text="{Binding ErrorMessage}" TextColor="#FECACA" FontSize="13"
                   IsVisible="{Binding ErrorMessage, Converter={StaticResource IsNotNull}}"/>
        </VerticalStackLayout>

        <!-- Services -->
        <CollectionView Grid.Row="4" ItemsSource="{Binding Services}">
            <CollectionView.EmptyView>
                <Label Text="No services found." TextColor="White"
                       HorizontalOptions="Center" Margin="0,30,0,0"/>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:ServiceListItem">
                    <Border BackgroundColor="#F7F8FC" StrokeThickness="0"
                            StrokeShape="RoundRectangle 14"
                            Padding="14" Margin="0,0,0,12">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">

                            <!-- Image -->
                            <Border Grid.Column="0" WidthRequest="75" HeightRequest="75"
                                    BackgroundColor="#EDEEF3"
                                    StrokeShape="RoundRectangle 10"
                                    StrokeThickness="0" VerticalOptions="Start">
                                <Image Source="{Binding ImageUrl}" Aspect="AspectFill"/>
                            </Border>

                            <!-- Text and button -->
                            <Grid Grid.Column="1" ColumnDefinitions="*,Auto"
                                  RowDefinitions="Auto,Auto,Auto" RowSpacing="4">

                                <Label Grid.Row="0" Grid.Column="0" Text="{Binding Name}"
                                       FontSize="18" FontAttributes="Bold"
                                       TextColor="Black" LineBreakMode="TailTruncation"/>
                                <Label Grid.Row="0" Grid.Column="1" Text="{Binding PriceText}"
                                       FontSize="18" FontAttributes="Bold"
                                       TextColor="Black"/>

                                <Label Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Description}"
                                       FontSize="14" TextColor="#4A5F8A"
                                       MaxLines="2" LineBreakMode="TailTruncation"/>

                                <Label Grid.Row="2" Grid.Column="0" Text="{Binding DurationText}"
                                       FontSize="14" TextColor="#4A5F8A" VerticalOptions="Center"/>
                                <Button Grid.Row="2" Grid.Column="1" Text="Select"
                                        BackgroundColor="#1B2A4A" TextColor="White"
                                        CornerRadius="8" HeightRequest="36" Padding="16,0"
                                        Clicked="OnSelectClicked"/>
                            </Grid>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>
</ContentPage>