<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
             xmlns:vm="clr-namespace:SBSBeautySpa.Mobile.ViewModels"
             x:Class="SBSBeautySpa.Mobile.Views.ServicesPage"
             x:DataType="vm:ServicesViewModel"
             Shell.NavBarIsVisible="False">

    <Grid Padding="24,60,24,20" RowDefinitions="Auto,Auto,Auto,Auto,*"
          Background="{StaticResource PageGradient}">


        <!-- Header -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*" ColumnSpacing="14">
            <Image Grid.Column="0" WidthRequest="28" HeightRequest="28"
                   mi:MauiIcon.Value="{mi:Material Icon=ArrowBack, IconColor=White}">
                <Image.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnBackTapped"/>
                </Image.GestureRecognizers>
            </Image>

            <Label Grid.Column="1" Text="Services"
                   FontSize="28" FontFamily="OpenSansSemibold"
                   TextColor="White" VerticalOptions="Center"/>
        </Grid>

        <!-- Search -->
        <Border Grid.Row="1" Margin="0,16,0,0"
                BackgroundColor="White" StrokeThickness="0"
                StrokeShape="RoundRectangle 26" Padding="16,0">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" HeightRequest="46">
                <Image Grid.Column="0" WidthRequest="20" HeightRequest="20"
                       VerticalOptions="Center"
                       mi:MauiIcon.Value="{mi:Material Icon=Search, IconColor=#6E63A6}"/>
                <Entry Grid.Column="1"
                       Placeholder="Search services..."
                       PlaceholderColor="#A59CC9"
                       TextColor="#2B1B6B" FontFamily="OpenSansRegular"
                       BackgroundColor="Transparent"
                       VerticalOptions="Center"
                       Text="{Binding SearchText}"/>
            </Grid>
        </Border>

        <!-- Category chips -->
        <CollectionView Grid.Row="2" Margin="0,16,0,12" HeightRequest="48"
                        ItemsSource="{Binding Categories}"
                        ItemsLayout="HorizontalList">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:ServiceCategoryTab">
                    <Border BackgroundColor="{Binding ChipBackground}"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 22"
                            Padding="18,8" Margin="0,0,8,0">
                        <Label Text="{Binding Label}"
                               FontSize="14" FontFamily="OpenSansRegular"
                               TextColor="{Binding ChipTextColor}"
                               VerticalOptions="Center"/>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnCategoryTapped"/>
                        </Border.GestureRecognizers>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Loading / error -->
        <VerticalStackLayout Grid.Row="3">
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"
                               Color="White" HorizontalOptions="Center"/>
            <Label Text="{Binding ErrorMessage}" TextColor="#FECACA" FontSize="13"
                   IsVisible="{Binding ErrorMessage, Converter={StaticResource IsNotNull}}"/>
        </VerticalStackLayout>

        <!-- Services -->
        <CollectionView Grid.Row="4" ItemsSource="{Binding Services}">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="6" />
            </CollectionView.ItemsLayout>
            <CollectionView.EmptyView>
                <Label Text="No services found." TextColor="White" FontFamily="OpenSansRegular"
                       HorizontalOptions="Center" Margin="0,30,0,0"/>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:ServiceListItem">
                    <Border BackgroundColor="White" StrokeThickness="0"
                            StrokeShape="RoundRectangle 20"
                            Padding="14">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">

                            <!-- Image -->
                            <Border Grid.Column="0" WidthRequest="75" HeightRequest="75"
                                    BackgroundColor="#EFE9FF"
                                    StrokeShape="RoundRectangle 14"
                                    StrokeThickness="0" VerticalOptions="Start">
                                <Image Source="{Binding ImageUrl}" Aspect="AspectFill"/>
                            </Border>

                            <!-- Text and button -->
                            <Grid Grid.Column="1" ColumnDefinitions="*,Auto"
                                  RowDefinitions="Auto,Auto,Auto" RowSpacing="4">

                                <Label Grid.Row="0" Grid.Column="0" Text="{Binding Name}"
                                       FontSize="16" FontFamily="OpenSansSemibold"
                                       TextColor="#2B1B6B" LineBreakMode="TailTruncation"/>
                                <Label Grid.Row="0" Grid.Column="1" Text="{Binding PriceText}"
                                       FontSize="16" FontFamily="OpenSansSemibold"
                                       TextColor="#6D3FE0"/>

                                <Label Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Description}"
                                       FontSize="13" FontFamily="OpenSansRegular" TextColor="#6E63A6"
                                       MaxLines="2" LineBreakMode="TailTruncation"/>

                                <Label Grid.Row="2" Grid.Column="0" Text="{Binding DurationText}"
                                       FontSize="13" FontFamily="OpenSansRegular" TextColor="#6E63A6" VerticalOptions="Center"/>
                                <Button Grid.Row="2" Grid.Column="1" Text="Select"
                                        BackgroundColor="#6D3FE0" TextColor="White" FontFamily="OpenSansSemibold"
                                        CornerRadius="18" HeightRequest="36" Padding="16,0"
                                        Clicked="OnSelectClicked"/>
                            </Grid>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>
</ContentPage>