<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SBSBeautySpa.Mobile.Views.BookingPage"
             Shell.NavBarIsVisible="False">

    <Grid Background="{StaticResource PageGradient}">
        <ScrollView>
            <VerticalStackLayout Padding="20,56,20,24" Spacing="14">

                <VerticalStackLayout Spacing="2" Margin="0,0,0,8">
                    <Label Text="Booking" Style="{StaticResource ScreenTitle}" />
                    <Label Text="Book a treatment or manage your appointments"
                           TextColor="{StaticResource SoftText}" FontSize="14" />
                </VerticalStackLayout>

                <!-- Book a service -->
                <Border Style="{StaticResource ActionCard}">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                        <Border Style="{StaticResource IconBadge}">
                            <Image Source="ic_service.png" WidthRequest="26" HeightRequest="26"
                                   HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                            <Label Text="Book a service" Style="{StaticResource CardHeading}" />
                            <Label Text="Browse treatments and pick a time" Style="{StaticResource CardCaption}" />
                        </VerticalStackLayout>
                        <Label Grid.Column="2" Style="{StaticResource Chevron}" />
                    </Grid>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnServicesTapped" />
                    </Border.GestureRecognizers>
                </Border>

                <!-- Booking history -->
                <Border Style="{StaticResource ActionCard}">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                        <Border Style="{StaticResource IconBadge}">
                            <Image Source="ic_history.png" WidthRequest="26" HeightRequest="26"
                                   HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                            <Label Text="Booking history" Style="{StaticResource CardHeading}" />
                            <Label Text="Upcoming, past and cancelled bookings" Style="{StaticResource CardCaption}" />
                        </VerticalStackLayout>
                        <Label Grid.Column="2" Style="{StaticResource Chevron}" />
                    </Grid>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnHistoryTapped" />
                    </Border.GestureRecognizers>
                </Border>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>