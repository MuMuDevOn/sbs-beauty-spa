<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
             xmlns:vm="clr-namespace:SBSBeautySpa.Mobile.ViewModels"
             x:Class="SBSBeautySpa.Mobile.Views.BookingHistoryPage"
             x:DataType="vm:BookingHistoryViewModel"
             Shell.NavBarIsVisible="False">

    <Grid Background="{StaticResource PageGradient}"
          RowDefinitions="Auto,Auto,*" Padding="20,56,20,0">

        <!-- Header -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*" ColumnSpacing="12">
            <Image WidthRequest="28" HeightRequest="28" VerticalOptions="Center"
                   mi:MauiIcon.Value="{mi:Material Icon=ArrowBack, IconColor=White}">
                <Image.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnBackTapped" />
                </Image.GestureRecognizers>
            </Image>
            <Label Grid.Column="1" Text="Booking history" Style="{StaticResource ScreenTitle}"
                   FontSize="26" VerticalOptions="Center" />
        </Grid>

        <!-- Tabs -->
        <HorizontalStackLayout Grid.Row="1" Spacing="8" Margin="0,16,0,14"
                               BindableLayout.ItemsSource="{Binding Tabs}">
            <BindableLayout.ItemTemplate>
                <DataTemplate x:DataType="vm:BookingHistoryTab">
                    <Border BackgroundColor="{Binding ChipBackground}" StrokeThickness="0"
                            StrokeShape="RoundRectangle 20" Padding="18,8">
                        <Label Text="{Binding Name}" TextColor="{Binding ChipTextColor}" FontSize="15" />
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnTabTapped" />
                        </Border.GestureRecognizers>
                    </Border>
                </DataTemplate>
            </BindableLayout.ItemTemplate>
        </HorizontalStackLayout>

        <!-- Bookings -->
        <ScrollView Grid.Row="2">
            <VerticalStackLayout Spacing="12" Padding="0,0,0,24">

                <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"
                                   Color="White" HorizontalOptions="Center" />
                <Label Text="{Binding ErrorMessage}" TextColor="#FECACA" FontSize="13"
                       IsVisible="{Binding ErrorMessage, Converter={StaticResource IsNotNull}}" />
                <Label Text="No bookings here yet." TextColor="White" FontSize="15"
                       HorizontalOptions="Center" Margin="0,30,0,0"
                       IsVisible="{Binding HasNoBookings}" />

                <VerticalStackLayout Spacing="12" BindableLayout.ItemsSource="{Binding Bookings}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:BookingHistoryItem">
                            <Border Style="{StaticResource ActionCard}" Padding="14">
                                <VerticalStackLayout Spacing="8">

                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <Label Text="{Binding ServiceName}"
                                               Style="{StaticResource CardHeading}"
                                               VerticalOptions="Center" LineBreakMode="TailTruncation" />
                                        <Border Grid.Column="1" BackgroundColor="{Binding StatusBackColor}"
                                                StrokeThickness="0" StrokeShape="RoundRectangle 10"
                                                Padding="10,4" VerticalOptions="Center">
                                            <Label Text="{Binding Status}" FontSize="12" FontAttributes="Bold"
                                                   TextColor="{Binding StatusTextColor}" />
                                        </Border>
                                    </Grid>

                                    <Label Text="{Binding DateText}" Style="{StaticResource CardCaption}" />
                                    <Label Text="{Binding PriceText}" FontSize="17" FontAttributes="Bold"
                                           TextColor="{StaticResource NavyText}" />

                                    <!-- Confirmed -->
                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10"
                                          IsVisible="{Binding IsConfirmed}">
                                        <Button Text="Reschedule" Style="{StaticResource OutlineButton}"
                                                Clicked="OnRescheduleClicked" />
                                        <Button Grid.Column="1" Text="View Address"
                                                Style="{StaticResource PrimaryButton}"
                                                Clicked="OnViewAddressClicked" />
                                    </Grid>

                                    <!-- Pending deposit -->
                                    <Button Text="{Binding DepositLabel}" Style="{StaticResource PrimaryButton}"
                                            IsVisible="{Binding IsPending}"
                                            Clicked="OnPayDepositClicked" />
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>