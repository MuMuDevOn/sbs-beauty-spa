<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
             xmlns:vm="clr-namespace:SBSBeautySpa.Mobile.ViewModels"
             x:Class="SBSBeautySpa.Mobile.Views.BookingHistoryPage"
             Shell.NavBarIsVisible="False">

    <Grid Padding ="24,60,24,40" RowDefinitions="Auto,Auto,*">

        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint ="0,1">
                <GradientStop Color="#111827" Offset="0.00"/>
                <GradientStop Color="#1B2A4A" Offset="0.07"/>
                <GradientStop Color="#4D6893" Offset="0.34"/>
                <GradientStop Color="#7C93C4" Offset="0.74"/>
                <GradientStop Color="#9FBCE5" Offset="0.95"/>
            </LinearGradientBrush>
        </Grid.Background>

        <!--Header-->
        <Grid Grid.Row="0" ColumnDefinitions= "Auto, *, Auto, Auto" ColumnSpacing="14">
            <Image Grid.Column="0" WidthRequest="28" HeightRequest="28"
                mi:MauiIcon.Value="{mi:Material Icon = ArrowBack, IconColor= White}">
                <Image.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnBackTapped"/>
                </Image.GestureRecognizers>
            </Image>

            <Label Grid.Column="1" Text=" Booking History"
                FontFamily="SerifBold" FontSize="28"
                TextColor="White" VerticalOptions="Center"/>
            </Grid>
        
        <!--Tabs-->
        <CollectionView Grid.Row="1" Margin=" 0,16,0,12" HeightRequest="48"
                        ItemsSource="{Binding Tabs}" ItemsLayout="HorizontalList">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border BackgroundColor="{Binding ChipBackground}"
                            StrokeThickness="0" StrokeShape="RoundRectangle 22"
                            Padding="18,8" Margin="0,0,8,0">
                        <Label Text="{Binding Name}" FontFamily="SerifRegular" FontSize="16"
                               TextColor="{Binding ChipTextColor}" VerticalOptions="Center"/>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:BookingHistoryViewModel}}, Path=SelectTabCommand}"
                                CommandParameter="{Binding .}" />
                        </Border.GestureRecognizers>
                        
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!--Bookings-->
        <CollectionView Grid.Row="2" ItemsSource="{Binding Bookings}">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border BackgroundColor="White" Stroke="#DDE2EE" StrokeThickness="1"
                            StrokeShape="RoundRectangle 12" Padding="14" Margin="0,0,0,12">
                        <VerticalStackLayout Spacing="8">

                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="{Binding ServiceName}" FontFamily="SerifBold"
                                       FontSize="18" TextColor="{StaticResource NavyText}"
                                       VerticalOptions="Center"/>
                                <Border Grid.Column="1" Stroke="#B8C0D4" StrokeThickness="1"
                                        StrokeShape="RoundRectangle 6" Padding="10,4">
                                    <Label Text="{Binding Status}" FontFamily="SerifRegular"
                                            FontSize="13" TextColor="{StaticResource NavyText}"/>

                                </Border>
                            </Grid>
                            <Label Text="{Binding DateText}" FontFamily="SerifRegular"
                                   FontSize="13" TextColor="{StaticResource MutedText}"/>
                            <Label Text="{Binding PriceText}" FontFamily="SerifRegular"
                                   FontSize="16" TextColor="{StaticResource NavyText}"/>
                            
                            <!--Confirmed Buttons-->
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="10"
                                  IsVisible="{Binding IsConfirmed}">
                                <Button Text="Reschedule" BackgroundColor="White"
                                        TextColor="{StaticResource NavyText}"
                                        BorderColor="#B8C0D4" BorderWidth="1"
                                        CornerRadius="10" HeightRequest="42"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:BookingHistoryViewModel}}, Path=RescheduleCommand}"
                                        CommandParameter="{Binding .}" />
                                <Button Grid.Column="1" Text="View Address" TextColor="White"
                                        CornerRadius="10" HeightRequest="42"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:BookingHistoryViewModel}}, Path=ViewAddressCommand}"
                                        CommandParameter="{Binding .}" >
                                    <Button.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#2A3B63" Offset="0" />
                                            <GradientStop Color="#0F1B33" Offset="1" />
                                        </LinearGradientBrush>
                                    </Button.Background>
                                </Button>
                                
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>
</ContentPage>