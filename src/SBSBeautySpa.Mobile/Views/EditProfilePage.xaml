<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SBSBeautySpa.Mobile.Views.EditProfilePage"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*,Auto" Padding="20,50,20,16"
          Background="{StaticResource PageGradient}">

        <!-- Header: Back arrow + page title -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*" ColumnSpacing="14">
            <!-- Back arrow; tapping it triggers OnBackTapped -->
            <Label Text="←" FontSize="28" TextColor="White" VerticalOptions="Center">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnBackTapped" />
                </Label.GestureRecognizers>
            </Label>
            <!-- Page title -->
            <Label Grid.Column="1" Text="Edit Profile" Style="{StaticResource PageTitle}" />
        </Grid>

        <!-- Form: scrollable content containing the profile fields -->
        <ScrollView Grid.Row="1" Margin="0,24,0,0">
            <VerticalStackLayout Spacing="8">

                <!-- Section header -->
                <Label Text="PROFILE DETAILS" Style="{StaticResource CapsLabel}" />

                <!-- Card grouping the editable fields -->
                <Border Style="{StaticResource GroupCard}">
                    <VerticalStackLayout>

                        <!-- Name field -->
                        <VerticalStackLayout Padding="14,10" Spacing="2">
                            <Label Text="Name" Style="{StaticResource FieldLabel}" />
                            <Entry x:Name="NameEntry" Text="User name" Placeholder="Name"
                                   Style="{StaticResource FieldEntry}" />
                        </VerticalStackLayout>
                        <BoxView Style="{StaticResource Divider}" />

                        <!-- Email field (uses email keyboard) -->
                        <VerticalStackLayout Padding="14,10" Spacing="2">
                            <Label Text="Email address" Style="{StaticResource FieldLabel}" />
                            <Entry x:Name="EmailEntry" Text="userEmail@example.com"
                                   Placeholder="Email address" Keyboard="Email"
                                   Style="{StaticResource FieldEntry}" />
                        </VerticalStackLayout>
                        <BoxView Style="{StaticResource Divider}" />

                        <!-- Phone field (uses telephone keyboard) -->
                        <VerticalStackLayout Padding="14,10" Spacing="2">
                            <Label Text="Phone number" Style="{StaticResource FieldLabel}" />
                            <Entry x:Name="PhoneEntry" Placeholder="(Phone number)"
                                   Keyboard="Telephone"
                                   Style="{StaticResource FieldEntry}" />
                        </VerticalStackLayout>

                    </VerticalStackLayout>
                </Border>

                <!-- Helpful hint text below the card -->
                <Label Text="Update your details, then save your changes."
                       Style="{StaticResource HintText}" />
            </VerticalStackLayout>
        </ScrollView>

        <!-- Save button; triggers OnSaveClicked -->
        <Button Grid.Row="2" Text="Save changes" Margin="0,10,0,0"
                Style="{StaticResource PrimaryButton}" Clicked="OnSaveClicked" />
    </Grid>
</ContentPage>
