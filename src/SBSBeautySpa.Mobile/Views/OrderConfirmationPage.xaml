<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="SBSBeautySpa.Mobile.Views.OrderConfirmationPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
             xmlns:vm="clr-namespace:SBSBeautySpa.Mobile.ViewModels"
             xmlns:models="clr-namespace:SBSBeautySpa.Mobile.Models"
             xmlns:conv="clr-namespace:SBSBeautySpa.Mobile.Converters"
             x:DataType="vm:OrderConfirmationViewModel"
             BackgroundColor="White"
             Shell.NavBarIsVisible="False">

    <ContentPage.Resources>
        <Color x:Key="DeepNavy">#1B2A4A</Color>
        <Color x:Key="AccentBlue">#2F63E0</Color>
        <Color x:Key="InkText">#111827</Color>
        <Color x:Key="MutedGray">#8A93A6</Color>
        <Color x:Key="SoftBlue">#EEF3FD</Color>
        <Color x:Key="CardStroke">#E3E9F5</Color>
        <LinearGradientBrush x:Key="BlueGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#1B2A4A" Offset="0.0" />
            <GradientStop Color="#2F63E0" Offset="1.0" />
        </LinearGradientBrush>
        <conv:InvertedBoolConverter x:Key="InvertedBool" />
        <conv:IsNotNullConverter x:Key="IsNotNull" />
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,Auto,*,Auto">
        <Grid Grid.Row="0" Padding="20,44,20,10" ColumnDefinitions="Auto,*" ColumnSpacing="14">
            <Image Grid.Column="0" WidthRequest="26" HeightRequest="26" VerticalOptions="Center"
                   mi:MauiIcon.Value="{mi:Material Icon=ArrowBack, IconColor=#111827}">
                <Image.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnBackTapped" />
                </Image.GestureRecognizers>
            </Image>
            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                <Label Text="Confirmation" FontSize="26" FontFamily="OpenSansSemibold" TextColor="{StaticResource InkText}" />
                <Label Text="Thank you for your order" FontSize="13" TextColor="{StaticResource MutedGray}" />
            </VerticalStackLayout>
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="*,*,*" ColumnSpacing="8" Margin="20,0,20,12">
            <Border Grid.Column="0" Padding="0,9" BackgroundColor="{StaticResource SoftBlue}" StrokeThickness="0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>
                <Label Text="DELIVERY" FontSize="11" FontFamily="OpenSansSemibold" TextColor="{StaticResource MutedGray}" HorizontalOptions="Center" />
            </Border>
            <Border Grid.Column="1" Padding="0,9" BackgroundColor="{StaticResource SoftBlue}" StrokeThickness="0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>
                <Label Text="PAYMENT" FontSize="11" FontFamily="OpenSansSemibold" TextColor="{StaticResource MutedGray}" HorizontalOptions="Center" />
            </Border>
            <Border Grid.Column="2" Padding="0,9" BackgroundColor="{StaticResource AccentBlue}" StrokeThickness="0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>
                <Label Text="CONFIRMATION" FontSize="11" FontFamily="OpenSansSemibold" TextColor="White" HorizontalOptions="Center" />
            </Border>
        </Grid>

        <ScrollView Grid.Row="2">
            <VerticalStackLayout Padding="16,8,16,24" Spacing="16">

                <Border WidthRequest="84" HeightRequest="84" HorizontalOptions="Center" Background="{StaticResource BlueGradient}" StrokeThickness="0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="42" />
                    </Border.StrokeShape>
                    <Label Text="&#10003;" FontSize="44" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>
                <Label Text="Order placed!" FontSize="24" FontFamily="OpenSansSemibold" TextColor="{StaticResource InkText}" HorizontalOptions="Center" />
                <Label Text="We've received your payment and will prepare your parcel for The Courier Guy." FontSize="14" TextColor="#4B5563"
                       HorizontalTextAlignment="Center" Margin="12,0" />

                <Border Padding="18" BackgroundColor="{StaticResource SoftBlue}" StrokeThickness="0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="18" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="12">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="ORDER NUMBER" FontSize="11" FontFamily="OpenSansSemibold" TextColor="{StaticResource MutedGray}" />
                            <Label Text="{Binding OrderNumber}" FontSize="16" TextColor="{StaticResource InkText}" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Spacing="2">
                            <Label Text="TOTAL PAID" FontSize="11" FontFamily="OpenSansSemibold" TextColor="{StaticResource MutedGray}" />
                            <Label Text="{Binding TotalPaid}" FontSize="18" TextColor="{StaticResource InkText}" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Spacing="2">
                            <Label Text="DELIVERY" FontSize="11" FontFamily="OpenSansSemibold" TextColor="{StaticResource MutedGray}" />
                            <Label Text="{Binding Delivery}" FontSize="14" TextColor="{StaticResource InkText}" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Spacing="2">
                            <Label Text="DELIVERING TO" FontSize="11" FontFamily="OpenSansSemibold" TextColor="{StaticResource MutedGray}" />
                            <Label Text="{Binding Address}" FontSize="14" TextColor="{StaticResource InkText}" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Spacing="2" IsVisible="{Binding Reference, Converter={StaticResource IsNotNull}}">
                            <Label Text="PAYMENT REFERENCE" FontSize="11" FontFamily="OpenSansSemibold" TextColor="{StaticResource MutedGray}" />
                            <Label Text="{Binding Reference}" FontSize="12" TextColor="{StaticResource InkText}" />
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>

        <VerticalStackLayout Grid.Row="3" Padding="16,10,16,18" Spacing="10" BackgroundColor="White">
            <Button Text="Continue Shopping" FontFamily="OpenSansSemibold" FontSize="16" HeightRequest="54" CornerRadius="16"
                    Background="{StaticResource BlueGradient}" TextColor="White" Clicked="OnContinueShoppingClicked" />
            <Button Text="Back to Home" FontFamily="OpenSansSemibold" FontSize="16" HeightRequest="54" CornerRadius="16"
                    BackgroundColor="White" TextColor="{StaticResource DeepNavy}" BorderColor="{StaticResource CardStroke}" BorderWidth="1.5"
                    Clicked="OnHomeClicked" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
