<?xml version="1.0" encoding="UTF-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:views="clr-namespace:SBSBeautySpa.Mobile.Views"
       x:Class="SBSBeautySpa.Mobile.Views.ClientShell"
       FlyoutBehavior="Disabled"
       Shell.TabBarBackgroundColor="White"
       Shell.TabBarForegroundColor="#6D3FE0"
       Shell.TabBarTitleColor="#6D3FE0"
       Shell.TabBarUnselectedColor="#9A93BF">

    <TabBar Route="Main">
        <ShellContent Title="Home" Icon="tab_home.svg"
                      Route="HomePage"
                      ContentTemplate="{DataTemplate views:HomePage}" />
        <ShellContent Title="Booking" Icon="tab_bookings.svg"
                      Route="BookingPage"
                      ContentTemplate="{DataTemplate views:BookingPage}" />
        <ShellContent Title="Shop" Icon="tab_shop.svg"
                      Route="ShopView"
                      ContentTemplate="{DataTemplate views:ShopView}" />
        <ShellContent Title="Gallery" Icon="tab_gallery.svg"
                      Route="GalleryView"
                      ContentTemplate="{DataTemplate views:GalleryView}" />
        <ShellContent Title="Profile" Icon="tab_profile.svg"
                      Route="ProfilePage"
                      ContentTemplate="{DataTemplate views:ProfilePage}" />
    </TabBar>

</Shell>