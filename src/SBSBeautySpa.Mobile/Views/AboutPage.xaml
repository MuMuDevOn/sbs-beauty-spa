<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
             x:Class="SBSBeautySpa.Mobile.Views.AboutPage"
             Shell.NavBarIsVisible="False">

    <!-- Same purple / blue / white theme as the Home and Services pages -->
    <Grid RowDefinitions="Auto,*" Padding="20,50,20,16"
          Background="{StaticResource PageGradient}">

        <!-- Header: Back arrow + page title -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*" ColumnSpacing="14">
            <Image WidthRequest="26" HeightRequest="26" VerticalOptions="Center"
                   mi:MauiIcon.Value="{mi:Material Icon=ArrowBack, IconColor=White}">
                <Image.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnBackTapped" />
                </Image.GestureRecognizers>
            </Image>
            <Label Grid.Column="1" Text="About" Style="{StaticResource PageTitle}" />
        </Grid>

        <ScrollView Grid.Row="1" Margin="0,24,0,0">
            <VerticalStackLayout x:Name="ContentColumn" HorizontalOptions="Center" Spacing="12">

                <Label Text="Tap a section to read it." Style="{StaticResource HintText}" />

                <Border Style="{StaticResource GroupCard}">
                    <VerticalStackLayout>
                        <Grid ColumnDefinitions="*,Auto" Padding="16,16">
                            <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                                <Label Text="About the App" Style="{StaticResource RowTitle}" />
                                <Label Text="Background information" Style="{StaticResource RowSubtitle}" />
                            </VerticalStackLayout>
                            <Image x:Name="AboutChevron" Grid.Column="1" WidthRequest="26" HeightRequest="26"
                                   VerticalOptions="Center"
                                   mi:MauiIcon.Value="{mi:Material Icon=ExpandMore, IconColor=#6E63A6}" />
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnAboutTapped" />
                            </Grid.GestureRecognizers>
                        </Grid>
                        <VerticalStackLayout x:Name="AboutBody" IsVisible="False" Padding="16,0,16,16" Spacing="4" />
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource GroupCard}">
                    <VerticalStackLayout>
                        <Grid ColumnDefinitions="*,Auto" Padding="16,16">
                            <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                                <Label Text="Terms and Conditions" Style="{StaticResource RowTitle}" />
                                <Label Text="How using SBS Beauty Spa works" Style="{StaticResource RowSubtitle}" />
                            </VerticalStackLayout>
                            <Image x:Name="TermsChevron" Grid.Column="1" WidthRequest="26" HeightRequest="26"
                                   VerticalOptions="Center"
                                   mi:MauiIcon.Value="{mi:Material Icon=ExpandMore, IconColor=#6E63A6}" />
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnTermsTapped" />
                            </Grid.GestureRecognizers>
                        </Grid>
                        <VerticalStackLayout x:Name="TermsBody" IsVisible="False" Padding="16,0,16,16" Spacing="4" />
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource GroupCard}">
                    <VerticalStackLayout>
                        <Grid ColumnDefinitions="*,Auto" Padding="16,16">
                            <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                                <Label Text="Privacy Policy" Style="{StaticResource RowTitle}" />
                                <Label Text="How we protect your information (POPIA)" Style="{StaticResource RowSubtitle}" />
                            </VerticalStackLayout>
                            <Image x:Name="PrivacyChevron" Grid.Column="1" WidthRequest="26" HeightRequest="26"
                                   VerticalOptions="Center"
                                   mi:MauiIcon.Value="{mi:Material Icon=ExpandMore, IconColor=#6E63A6}" />
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnPrivacyTapped" />
                            </Grid.GestureRecognizers>
                        </Grid>
                        <VerticalStackLayout x:Name="PrivacyBody" IsVisible="False" Padding="16,0,16,16" Spacing="4" />
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource GroupCard}">
                    <VerticalStackLayout>
                        <Grid ColumnDefinitions="*,Auto" Padding="16,16">
                            <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                                <Label Text="Cancellation Policy" Style="{StaticResource RowTitle}" />
                                <Label Text="Rescheduling and cancelling appointments" Style="{StaticResource RowSubtitle}" />
                            </VerticalStackLayout>
                            <Image x:Name="CancellationChevron" Grid.Column="1" WidthRequest="26" HeightRequest="26"
                                   VerticalOptions="Center"
                                   mi:MauiIcon.Value="{mi:Material Icon=ExpandMore, IconColor=#6E63A6}" />
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnCancellationTapped" />
                            </Grid.GestureRecognizers>
                        </Grid>
                        <VerticalStackLayout x:Name="CancellationBody" IsVisible="False" Padding="16,0,16,16" Spacing="4" />
                    </VerticalStackLayout>
                </Border>

                <Label x:Name="UpdatedLabel" Style="{StaticResource HintText}" Margin="4,6,0,16" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
