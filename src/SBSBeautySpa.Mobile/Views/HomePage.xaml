<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
             xmlns:vm="clr-namespace:SBSBeautySpa.Mobile.ViewModels"
             x:Class="SBSBeautySpa.Mobile.Views.HomePage"
             x:DataType="vm:HomeViewModel"
             Title="Home"
             Shell.NavBarIsVisible="False">

    <ContentPage.Resources>

        <!-- Real values are set in HomePage.xaml.cs once the page width is known -->
        <x:Double x:Key="CardWidth">160</x:Double>
        <x:Double x:Key="CardImageWidth">140</x:Double>
        <x:Double x:Key="CardImageHeight">130</x:Double>
        <x:Double x:Key="RowWidth">320</x:Double>
        <x:Double x:Key="ProductCardWidth">160</x:Double>
        <x:Double x:Key="ProductImageWidth">140</x:Double>
        <x:Double x:Key="ProductImageHeight">130</x:Double>

        <Style x:Key="SectionTitle" TargetType="Label">
            <Setter Property="TextColor" Value="White" />
            <Setter Property="FontFamily" Value="OpenSansSemibold" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="VerticalOptions" Value="Center" />
        </Style>
        <Style x:Key="ResultHeading" TargetType="Label">
            <Setter Property="TextColor" Value="White" />
            <Setter Property="FontFamily" Value="OpenSansSemibold" />
            <Setter Property="FontSize" Value="16" />
        </Style>
        <Style x:Key="FilterHeading" TargetType="Label">
            <Setter Property="TextColor" Value="#2B1B6B" />
            <Setter Property="FontFamily" Value="OpenSansSemibold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="0,6,0,2" />
        </Style>
        <Style x:Key="ViewAll" TargetType="Label">
            <Setter Property="TextColor" Value="White" />
            <Setter Property="FontFamily" Value="OpenSansSemibold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalOptions" Value="Center" />
        </Style>
        <Style x:Key="CardTitle" TargetType="Label">
            <Setter Property="TextColor" Value="#2B1B6B" />
            <Setter Property="FontFamily" Value="OpenSansSemibold" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="LineBreakMode" Value="TailTruncation" />
            <Setter Property="MaxLines" Value="1" />
        </Style>
        <Style x:Key="CardSubtitle" TargetType="Label">
            <Setter Property="TextColor" Value="#6E63A6" />
            <Setter Property="FontFamily" Value="OpenSansRegular" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="LineBreakMode" Value="TailTruncation" />
            <Setter Property="MaxLines" Value="1" />
        </Style>

        <DataTemplate x:Key="FilterChipTemplate" x:DataType="vm:FilterChip">
            <Border BackgroundColor="{Binding ChipBackground}" StrokeThickness="0"
                    StrokeShape="RoundRectangle 16" Padding="14,7" Margin="0,0,8,8">
                <Label Text="{Binding Label}" TextColor="{Binding ChipTextColor}" FontSize="13" />
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnFilterChipTapped" />
                </Border.GestureRecognizers>
            </Border>
        </DataTemplate>

        <!-- A service as a row (Popular Services + search results) -->
        <DataTemplate x:Key="ServiceRowTemplate" x:DataType="vm:HomeServiceCard">
            <Border WidthRequest="{DynamicResource RowWidth}"
                    BackgroundColor="White" StrokeThickness="0"
                    StrokeShape="RoundRectangle 20" Padding="12" Margin="0,0,0,12">
                <Border.Shadow>
                    <Shadow Brush="Black" Opacity="0.18" Radius="12" Offset="0,4" />
                </Border.Shadow>
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                    <Border WidthRequest="64" HeightRequest="64" StrokeThickness="0"
                            StrokeShape="RoundRectangle 16" BackgroundColor="#EFE9FF">
                        <Image Source="{Binding ImageUrl}" Aspect="AspectFill"
                               WidthRequest="64" HeightRequest="64"
                               HorizontalOptions="Fill" VerticalOptions="Fill" />
                    </Border>
                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="3">
                        <Label Text="{Binding Name}" Style="{StaticResource CardTitle}" />
                        <Label Text="{Binding DurationSubtitle}" Style="{StaticResource CardSubtitle}" />
                    </VerticalStackLayout>
                    <Border Grid.Column="2" BackgroundColor="#EFE9FF" StrokeThickness="0"
                            StrokeShape="RoundRectangle 14" Padding="12,6" VerticalOptions="Center">
                        <Label Text="{Binding PriceLabel}" TextColor="#2B1B6B"
                               FontFamily="OpenSansSemibold" FontSize="13" />
                    </Border>
                </Grid>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnServiceTapped" />
                </Border.GestureRecognizers>
            </Border>
        </DataTemplate>

        <!-- A product as a card (New Arrivals + search results).
             Card and photo have EXACT widths, so any photo is cropped to fit. -->
        <DataTemplate x:Key="ProductCardTemplate" x:DataType="vm:HomeProductCard">
            <Border WidthRequest="{DynamicResource ProductCardWidth}"
                    BackgroundColor="White" StrokeThickness="0" StrokeShape="RoundRectangle 22"
                    Padding="10" Margin="0,0,0,12">
                <Border.Shadow>
                    <Shadow Brush="Black" Opacity="0.18" Radius="12" Offset="0,4" />
                </Border.Shadow>
                <VerticalStackLayout Spacing="8">
                    <Border WidthRequest="{DynamicResource ProductImageWidth}" HeightRequest="{DynamicResource ProductImageHeight}"
                            HorizontalOptions="Start" StrokeThickness="0"
                            StrokeShape="RoundRectangle 16" BackgroundColor="#EFE9FF">
                        <Image Source="{Binding ImageUrl}" Aspect="AspectFill"
                               WidthRequest="{DynamicResource ProductImageWidth}" HeightRequest="{DynamicResource ProductImageHeight}"
                               HorizontalOptions="Fill" VerticalOptions="Fill" />
                    </Border>
                    <VerticalStackLayout Spacing="2" Padding="4,0,4,4">
                        <Label Text="{Binding Name}" Style="{StaticResource CardTitle}" />
                        <Label Text="{Binding Subtitle}" Style="{StaticResource CardSubtitle}" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnProductTapped" />
                </Border.GestureRecognizers>
            </Border>
        </DataTemplate>
    </ContentPage.Resources>

    <Grid Background="{StaticResource PageGradient}">
        <ScrollView>
            <!-- Content column: centred and capped so it never stretches on a wide window -->
            <VerticalStackLayout x:Name="ContentColumn"
                                 HorizontalOptions="Center"
                                 Padding="20,46,20,32" Spacing="22">

                <!-- Top row: logo + notifications bell -->
                <Grid ColumnDefinitions="*,Auto">
                    <Image Source="logo.png" HeightRequest="64" WidthRequest="110"
                           Aspect="AspectFit" HorizontalOptions="Start" VerticalOptions="Center" />

                    <Grid Grid.Column="1" WidthRequest="46" HeightRequest="46" VerticalOptions="Center">
                        <Border WidthRequest="46" HeightRequest="46"
                                StrokeShape="Ellipse" StrokeThickness="0"
                                BackgroundColor="#EFE9FF">
                            <Image Source="bellicon.png" WidthRequest="22" HeightRequest="22"
                                   Aspect="AspectFit"
                                   HorizontalOptions="Center" VerticalOptions="Center" />
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OpenNotificationsCommand}" />
                            </Border.GestureRecognizers>
                        </Border>
                        <!-- Red dot: shown when there are unread notifications -->
                        <Border x:Name="UnreadDot" IsVisible="False" InputTransparent="True"
                                WidthRequest="12" HeightRequest="12" StrokeShape="Ellipse"
                                BackgroundColor="#E5484D" Stroke="White" StrokeThickness="2"
                                HorizontalOptions="End" VerticalOptions="Start" Margin="0,2,2,0" />
                    </Grid>
                </Grid>

                <!-- Greeting -->
                <VerticalStackLayout Spacing="2" Margin="0,-4,0,0">
                    <Label Text="Hello," TextColor="#E3DDFB" FontFamily="OpenSansRegular" FontSize="15" />
                    <Label Text="Welcome!" TextColor="White" FontFamily="OpenSansSemibold" FontSize="32" />
                    <Label Text="What would you like to book today?" TextColor="#E3DDFB"
                           FontFamily="OpenSansRegular" FontSize="13" />
                </VerticalStackLayout>

                <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"
                                   Color="White" HorizontalOptions="Center" />
                <Label Text="{Binding ErrorMessage}" TextColor="#FECACA" FontSize="13"
                       IsVisible="{Binding ErrorMessage, Converter={StaticResource IsNotNull}}" />

                <!-- Search bar + Filters button -->
                <Border BackgroundColor="White" StrokeThickness="0"
                        StrokeShape="RoundRectangle 28" Padding="18,0,8,0"
                        HeightRequest="54">
                    <Border.Shadow>
                        <Shadow Brush="Black" Opacity="0.2" Radius="14" Offset="0,5" />
                    </Border.Shadow>
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                        <Image Grid.Column="0" WidthRequest="20" HeightRequest="20"
                               VerticalOptions="Center"
                               mi:MauiIcon.Value="{mi:Material Icon=Search, IconColor=#6E63A6}" />

                        <Entry Grid.Column="1"
                               Placeholder="Search nails, lashes, press-ons..."
                               PlaceholderColor="#A59CC9"
                               TextColor="#2B1B6B"
                               BackgroundColor="Transparent"
                               FontFamily="OpenSansRegular"
                               FontSize="14"
                               VerticalOptions="Center"
                               ReturnType="Done"
                               Text="{Binding SearchText}" />

                        <Border Grid.Column="2" BackgroundColor="#6D3FE0" StrokeThickness="0"
                                StrokeShape="RoundRectangle 20" Padding="14,0"
                                HeightRequest="38" VerticalOptions="Center">
                            <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                <Image WidthRequest="16" HeightRequest="16" VerticalOptions="Center"
                                       mi:MauiIcon.Value="{mi:Material Icon=Tune, IconColor=White}" />
                                <Label Text="{Binding FilterButtonText}" FontFamily="OpenSansSemibold"
                                       FontSize="13" TextColor="White" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ToggleFilterPanelCommand}" />
                            </Border.GestureRecognizers>
                        </Border>
                    </Grid>
                </Border>

                <!-- Filter panel (opens in place, nothing navigates away) -->
                <Border IsVisible="{Binding IsFilterPanelOpen}"
                        BackgroundColor="White" StrokeThickness="0"
                        StrokeShape="RoundRectangle 24" Padding="18">
                    <Border.Shadow>
                        <Shadow Brush="Black" Opacity="0.2" Radius="14" Offset="0,5" />
                    </Border.Shadow>
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Show" Style="{StaticResource FilterHeading}" Margin="0,0,0,2" />
                        <FlexLayout Wrap="Wrap"
                                    BindableLayout.ItemsSource="{Binding TypeChips}"
                                    BindableLayout.ItemTemplate="{StaticResource FilterChipTemplate}" />

                        <Label Text="Category" Style="{StaticResource FilterHeading}" />
                        <FlexLayout Wrap="Wrap"
                                    BindableLayout.ItemsSource="{Binding CategoryChips}"
                                    BindableLayout.ItemTemplate="{StaticResource FilterChipTemplate}" />

                        <Label Text="Price" Style="{StaticResource FilterHeading}" />
                        <FlexLayout Wrap="Wrap"
                                    BindableLayout.ItemsSource="{Binding PriceChips}"
                                    BindableLayout.ItemTemplate="{StaticResource FilterChipTemplate}" />

                        <Label Text="Sort by" Style="{StaticResource FilterHeading}" />
                        <FlexLayout Wrap="Wrap"
                                    BindableLayout.ItemsSource="{Binding SortChips}"
                                    BindableLayout.ItemTemplate="{StaticResource FilterChipTemplate}" />

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,8,0,0">
                            <Button Text="Clear all" Command="{Binding ClearFiltersCommand}"
                                    BackgroundColor="Transparent" TextColor="#2B1B6B"
                                    BorderColor="#6D3FE0" BorderWidth="1" CornerRadius="14"
                                    FontFamily="OpenSansSemibold" HeightRequest="46" />
                            <Button Grid.Column="1" Text="Show results"
                                    Command="{Binding ToggleFilterPanelCommand}"
                                    BackgroundColor="#6D3FE0" TextColor="White" CornerRadius="14"
                                    FontFamily="OpenSansSemibold" HeightRequest="46" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Category shortcuts: icons come straight from Resources\Images -->
                <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                    <HorizontalStackLayout Spacing="14" x:Name="ShortcutRow">
                        <VerticalStackLayout Spacing="8" WidthRequest="72">
                            <Border x:Name="CatNailsCircle" WidthRequest="64" HeightRequest="64"
                                    StrokeShape="Ellipse" StrokeThickness="2" Stroke="#55FFFFFF"
                                    BackgroundColor="Black" HorizontalOptions="Center">
                                <Image x:Name="CatNailsIcon" Source="scissors.png"
                                       WidthRequest="28" HeightRequest="28" Aspect="AspectFit"
                                       HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <Label Text="Nails" TextColor="White" FontFamily="OpenSansRegular"
                                   FontSize="12" HorizontalTextAlignment="Center" />
                            <VerticalStackLayout.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnCategoryShortcutTapped" CommandParameter="Nails" />
                            </VerticalStackLayout.GestureRecognizers>
                        </VerticalStackLayout>
                        <VerticalStackLayout Spacing="8" WidthRequest="72">
                            <Border x:Name="CatLashesCircle" WidthRequest="64" HeightRequest="64"
                                    StrokeShape="Ellipse" StrokeThickness="2" Stroke="#55FFFFFF"
                                    BackgroundColor="White" HorizontalOptions="Center">
                                <Image x:Name="CatLashesIcon" Source="eye.png"
                                       WidthRequest="28" HeightRequest="28" Aspect="AspectFit"
                                       HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <Label Text="Lashes" TextColor="White" FontFamily="OpenSansRegular"
                                   FontSize="12" HorizontalTextAlignment="Center" />
                            <VerticalStackLayout.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnCategoryShortcutTapped" CommandParameter="Lashes" />
                            </VerticalStackLayout.GestureRecognizers>
                        </VerticalStackLayout>
                        <VerticalStackLayout Spacing="8" WidthRequest="72">
                            <Border x:Name="CatPressOnsCircle" WidthRequest="64" HeightRequest="64"
                                    StrokeShape="Ellipse" StrokeThickness="2" Stroke="#55FFFFFF"
                                    BackgroundColor="White" HorizontalOptions="Center">
                                <Image x:Name="CatPressOnsIcon" Source="package_icon.png"
                                       WidthRequest="28" HeightRequest="28" Aspect="AspectFit"
                                       HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <Label Text="Press-Ons" TextColor="White" FontFamily="OpenSansRegular"
                                   FontSize="12" HorizontalTextAlignment="Center" />
                            <VerticalStackLayout.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnCategoryShortcutTapped" CommandParameter="PressOns" />
                            </VerticalStackLayout.GestureRecognizers>
                        </VerticalStackLayout>
                        <VerticalStackLayout Spacing="8" WidthRequest="72">
                            <Border x:Name="CatGelXCircle" WidthRequest="64" HeightRequest="64"
                                    StrokeShape="Ellipse" StrokeThickness="2" Stroke="#55FFFFFF"
                                    BackgroundColor="White" HorizontalOptions="Center">
                                <Image x:Name="CatGelXIcon" Source="droplet.png"
                                       WidthRequest="28" HeightRequest="28" Aspect="AspectFit"
                                       HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <Label Text="Gel X" TextColor="White" FontFamily="OpenSansRegular"
                                   FontSize="12" HorizontalTextAlignment="Center" />
                            <VerticalStackLayout.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnCategoryShortcutTapped" CommandParameter="GelX" />
                            </VerticalStackLayout.GestureRecognizers>
                        </VerticalStackLayout>
                        <VerticalStackLayout Spacing="8" WidthRequest="72">
                            <Border x:Name="CatShopCircle" WidthRequest="64" HeightRequest="64"
                                    StrokeShape="Ellipse" StrokeThickness="2" Stroke="#55FFFFFF"
                                    BackgroundColor="White" HorizontalOptions="Center">
                                <Image x:Name="CatShopIcon" Source="shopping_bag.png"
                                       WidthRequest="28" HeightRequest="28" Aspect="AspectFit"
                                       HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <Label Text="Shop" TextColor="White" FontFamily="OpenSansRegular"
                                   FontSize="12" HorizontalTextAlignment="Center" />
                            <VerticalStackLayout.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnCategoryShortcutTapped" CommandParameter="Shop" />
                            </VerticalStackLayout.GestureRecognizers>
                        </VerticalStackLayout>
                    </HorizontalStackLayout>
                </ScrollView>

                <!-- ============ RESULTS (shown while searching / filtering) ============ -->
                <VerticalStackLayout IsVisible="{Binding IsFiltering}" Spacing="14">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="{Binding ResultSummary}" Style="{StaticResource SectionTitle}" />
                        <Border Grid.Column="1" BackgroundColor="#33FFFFFF" StrokeThickness="0"
                                StrokeShape="RoundRectangle 14" Padding="14,6" VerticalOptions="Center">
                            <Label Text="Clear" Style="{StaticResource ViewAll}" />
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ClearFiltersCommand}" />
                            </Border.GestureRecognizers>
                        </Border>
                    </Grid>

                    <Label Text="No matches found. Try a different search or clear the filters."
                           TextColor="White" FontFamily="OpenSansRegular" FontSize="14"
                           IsVisible="{Binding HasNoResults}" />

                    <Label Text="Services" Style="{StaticResource ResultHeading}"
                           IsVisible="{Binding HasServiceResults}" />
                    <FlexLayout Wrap="Wrap" JustifyContent="SpaceBetween" AlignItems="Start"
                                IsVisible="{Binding HasServiceResults}"
                                BindableLayout.ItemsSource="{Binding ResultServices}"
                                BindableLayout.ItemTemplate="{StaticResource ServiceRowTemplate}" />

                    <Label Text="Products" Style="{StaticResource ResultHeading}"
                           IsVisible="{Binding HasProductResults}" />
                    <FlexLayout Wrap="Wrap" JustifyContent="SpaceBetween" AlignItems="Start"
                                IsVisible="{Binding HasProductResults}"
                                BindableLayout.ItemsSource="{Binding ResultProducts}"
                                BindableLayout.ItemTemplate="{StaticResource ProductCardTemplate}" />
                </VerticalStackLayout>

                <!-- ============ DEFAULT HOME (hidden while searching / filtering) ============ -->
                <VerticalStackLayout IsVisible="{Binding IsNotFiltering}" Spacing="22">

                    <!-- Sliding banner: pictures of services and products, same purple look as before -->
                    <Grid HeightRequest="170">
                        <Border StrokeThickness="0" StrokeShape="RoundRectangle 28" Padding="0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#F6F1FF" Offset="0.0" />
                                    <GradientStop Color="#B9A8F5" Offset="1.0" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.Shadow>
                                <Shadow Brush="Black" Opacity="0.22" Radius="16" Offset="0,6" />
                            </Border.Shadow>

                            <CarouselView x:Name="BannerCarousel" Loop="True" IsSwipeEnabled="True"
                                          ItemsSource="{Binding BannerSlides}"
                                          HeightRequest="170" HorizontalScrollBarVisibility="Never"
                                          IndicatorView="BannerDots">
                                <CarouselView.ItemTemplate>
                                    <DataTemplate x:DataType="vm:HomeBannerCard">
                                        <Grid Padding="20,18,16,28" ColumnDefinitions="*,Auto" ColumnSpacing="14">
                                            <VerticalStackLayout VerticalOptions="Center" Spacing="6">
                                                <Border BackgroundColor="#6D3FE0" StrokeThickness="0"
                                                        StrokeShape="RoundRectangle 14" Padding="12,6"
                                                        HorizontalOptions="Start">
                                                    <Label Text="{Binding Tag}" TextColor="White"
                                                           FontFamily="OpenSansSemibold" FontSize="11" />
                                                </Border>
                                                <Label Text="{Binding Title}" TextColor="#2B1B6B"
                                                       FontFamily="OpenSansSemibold" FontSize="22"
                                                       MaxLines="2" LineBreakMode="TailTruncation" />
                                                <Label Text="{Binding Subtitle}" TextColor="#5B4BB0"
                                                       FontFamily="OpenSansRegular" FontSize="13"
                                                       MaxLines="1" LineBreakMode="TailTruncation" />
                                            </VerticalStackLayout>
                                            <Border Grid.Column="1" WidthRequest="118" HeightRequest="118"
                                                    StrokeThickness="0" StrokeShape="RoundRectangle 20"
                                                    BackgroundColor="#EFE9FF" VerticalOptions="Center">
                                                <Image Source="{Binding ImageUrl}" Aspect="AspectFill"
                                                       WidthRequest="118" HeightRequest="118" />
                                            </Border>
                                            <Grid.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="OnBannerTapped" />
                                            </Grid.GestureRecognizers>
                                        </Grid>
                                    </DataTemplate>
                                </CarouselView.ItemTemplate>
                                <CarouselView.EmptyView>
                                    <Grid Padding="20">
                                        <VerticalStackLayout VerticalOptions="End" Spacing="2">
                                            <Label Text="SBS Beauty Spa" TextColor="#2B1B6B"
                                                   FontFamily="OpenSansSemibold" FontSize="24" />
                                            <Label Text="Nails, lashes and press-ons" TextColor="#5B4BB0"
                                                   FontFamily="OpenSansRegular" FontSize="13" />
                                        </VerticalStackLayout>
                                    </Grid>
                                </CarouselView.EmptyView>
                            </CarouselView>
                        </Border>

                        <IndicatorView x:Name="BannerDots" HorizontalOptions="Center" VerticalOptions="End"
                                       Margin="0,0,0,10" IndicatorSize="7" IndicatorColor="#80FFFFFF"
                                       SelectedIndicatorColor="#6D3FE0" InputTransparent="True" />
                    </Grid>

                    <!-- Trending Styles -->
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Trending Styles" Style="{StaticResource SectionTitle}" />
                        <Border Grid.Column="1" BackgroundColor="#33FFFFFF" StrokeThickness="0"
                                StrokeShape="RoundRectangle 14" Padding="14,6" VerticalOptions="Center">
                            <Label Text="View all" Style="{StaticResource ViewAll}" />
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ViewAllTrendingCommand}" />
                            </Border.GestureRecognizers>
                        </Border>
                    </Grid>

                    <FlexLayout Wrap="Wrap" JustifyContent="SpaceBetween" AlignItems="Start"
                                BindableLayout.ItemsSource="{Binding TrendingServices}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:HomeServiceCard">
                                <Border WidthRequest="{DynamicResource CardWidth}"
                                        BackgroundColor="White" StrokeThickness="0"
                                        StrokeShape="RoundRectangle 22"
                                        Padding="10" Margin="0,0,0,12">
                                    <Border.Shadow>
                                        <Shadow Brush="Black" Opacity="0.18" Radius="12" Offset="0,4" />
                                    </Border.Shadow>
                                    <VerticalStackLayout Spacing="8">
                                        <Border WidthRequest="{DynamicResource CardImageWidth}" HeightRequest="{DynamicResource CardImageHeight}"
                                                HorizontalOptions="Start" StrokeThickness="0"
                                                StrokeShape="RoundRectangle 16" BackgroundColor="#EFE9FF">
                                            <Image Source="{Binding ImageUrl}" Aspect="AspectFill"
                                                   WidthRequest="{DynamicResource CardImageWidth}" HeightRequest="{DynamicResource CardImageHeight}"
                                                   HorizontalOptions="Fill" VerticalOptions="Fill" />
                                        </Border>
                                        <VerticalStackLayout Spacing="2" Padding="4,0,4,4">
                                            <Label Text="{Binding Name}" Style="{StaticResource CardTitle}" />
                                            <Label Text="{Binding PriceSubtitle}" Style="{StaticResource CardSubtitle}" />
                                        </VerticalStackLayout>
                                    </VerticalStackLayout>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnServiceTapped" />
                                    </Border.GestureRecognizers>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </FlexLayout>

                    <!-- New Arrival Press-Ons -->
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="New Arrival Press-Ons" Style="{StaticResource SectionTitle}" />
                        <Border Grid.Column="1" BackgroundColor="#33FFFFFF" StrokeThickness="0"
                                StrokeShape="RoundRectangle 14" Padding="14,6" VerticalOptions="Center">
                            <Label Text="View all" Style="{StaticResource ViewAll}" />
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ViewAllNewArrivalsCommand}" />
                            </Border.GestureRecognizers>
                        </Border>
                    </Grid>

                    <FlexLayout Wrap="Wrap" JustifyContent="SpaceBetween" AlignItems="Start"
                                BindableLayout.ItemsSource="{Binding NewArrivals}"
                                BindableLayout.ItemTemplate="{StaticResource ProductCardTemplate}" />

                    <!-- Popular Services -->
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Popular Services" Style="{StaticResource SectionTitle}" />
                        <Border Grid.Column="1" BackgroundColor="#33FFFFFF" StrokeThickness="0"
                                StrokeShape="RoundRectangle 14" Padding="14,6" VerticalOptions="Center">
                            <Label Text="View all" Style="{StaticResource ViewAll}" />
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ViewAllPopularCommand}" />
                            </Border.GestureRecognizers>
                        </Border>
                    </Grid>

                    <FlexLayout Wrap="Wrap" JustifyContent="SpaceBetween" AlignItems="Start"
                                BindableLayout.ItemsSource="{Binding PopularServices}"
                                BindableLayout.ItemTemplate="{StaticResource ServiceRowTemplate}" />
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
