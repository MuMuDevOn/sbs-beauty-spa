<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
             xmlns:vm="clr-namespace:SBSBeautySpa.Mobile.ViewModels"
             x:Class="SBSBeautySpa.Mobile.Views.HomePage"
             x:DataType="vm:HomeViewModel"
             Title="Home"
             Shell.NavBarIsVisible="False">

    <ContentPage.Resources>

        <!-- Section heading on the gradient -->
        <Style x:Key="SectionTitle" TargetType="Label">
            <Setter Property="TextColor" Value="White" />
            <Setter Property="FontFamily" Value="OpenSansSemibold" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="VerticalOptions" Value="Center" />
        </Style>
        <Style x:Key="ResultHeading" TargetType="Label">
            <Setter Property="TextColor" Value="White" />
            <Setter Property="FontFamily" Value="OpenSansSemibold" />
            <Setter Property="FontSize" Value="16" />
        </Style>
        <Style x:Key="FilterHeading" TargetType="Label">
            <Setter Property="TextColor" Value="#1B2A4A" />
            <Setter Property="FontFamily" Value="OpenSansSemibold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="0,6,0,2" />
        </Style>

        <!-- "View all" pill text -->
        <Style x:Key="ViewAll" TargetType="Label">
            <Setter Property="TextColor" Value="White" />
            <Setter Property="FontFamily" Value="OpenSansSemibold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalOptions" Value="Center" />
        </Style>

        <!-- Text inside white cards -->
        <Style x:Key="CardTitle" TargetType="Label">
            <Setter Property="TextColor" Value="#1B2A4A" />
            <Setter Property="FontFamily" Value="OpenSansSemibold" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="LineBreakMode" Value="TailTruncation" />
        </Style>
        <Style x:Key="CardSubtitle" TargetType="Label">
            <Setter Property="TextColor" Value="#5B6B8C" />
            <Setter Property="FontFamily" Value="OpenSansRegular" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="LineBreakMode" Value="TailTruncation" />
        </Style>

        <!-- One option in the filter panel -->
        <DataTemplate x:Key="FilterChipTemplate" x:DataType="vm:FilterChip">
            <Border BackgroundColor="{Binding ChipBackground}" StrokeThickness="0"
                    StrokeShape="RoundRectangle 16" Padding="14,7" Margin="0,0,8,8">
                <Label Text="{Binding Label}" TextColor="{Binding ChipTextColor}" FontSize="13" />
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnFilterChipTapped" />
                </Border.GestureRecognizers>
            </Border>
        </DataTemplate>

        <!-- A service as a row (Popular Services + search results) -->
        <DataTemplate x:Key="ServiceRowTemplate" x:DataType="vm:HomeServiceCard">
            <Border BackgroundColor="White" StrokeThickness="0"
                    StrokeShape="RoundRectangle 20" Padding="12">
                <Border.Shadow>
                    <Shadow Brush="Black" Opacity="0.18" Radius="12" Offset="0,4" />
                </Border.Shadow>
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                    <Border WidthRequest="60" HeightRequest="60" StrokeThickness="0"
                            StrokeShape="RoundRectangle 14" BackgroundColor="#E6EBF4">
                        <Image Source="{Binding ImageUrl}" Aspect="AspectFill" />
                    </Border>
                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="3">
                        <Label Text="{Binding Name}" Style="{StaticResource CardTitle}" />
                        <Label Text="{Binding DurationSubtitle}" Style="{StaticResource CardSubtitle}" />
                    </VerticalStackLayout>
                    <Border Grid.Column="2" BackgroundColor="#E6EBF4" StrokeThickness="0"
                            StrokeShape="RoundRectangle 14" Padding="12,6" VerticalOptions="Center">
                        <Label Text="{Binding PriceLabel}" TextColor="#1B2A4A"
                               FontFamily="OpenSansSemibold" FontSize="13" />
                    </Border>
                </Grid>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnServiceTapped" />
                </Border.GestureRecognizers>
            </Border>
        </DataTemplate>

        <!-- A product as a card (New Arrivals + search results) -->
        <DataTemplate x:Key="ProductCardTemplate" x:DataType="vm:HomeProductCard">
            <Border FlexLayout.Basis="47%" BackgroundColor="White"
                    StrokeThickness="0" StrokeShape="RoundRectangle 22"
                    Padding="10" Margin="0,0,0,14">
                <Border.Shadow>
                    <Shadow Brush="Black" Opacity="0.18" Radius="12" Offset="0,4" />
                </Border.Shadow>
                <VerticalStackLayout Spacing="8">
                    <Border HeightRequest="120" StrokeThickness="0"
                            StrokeShape="RoundRectangle 16" BackgroundColor="#E6EBF4">
                        <Image Source="{Binding ImageUrl}" Aspect="AspectFill" />
                    </Border>
                    <VerticalStackLayout Spacing="2" Padding="4,0,4,4">
                        <Label Text="{Binding Name}" Style="{StaticResource CardTitle}" />
                        <Label Text="{Binding Subtitle}" Style="{StaticResource CardSubtitle}" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnProductTapped" />
                </Border.GestureRecognizers>
            </Border>
        </DataTemplate>
    </ContentPage.Resources>

    <Grid Background="{StaticResource PageGradient}">
        <ScrollView>
            <VerticalStackLayout Padding="20,46,20,32" Spacing="22">

                <!-- Top row: logo + notifications bell -->
                <Grid ColumnDefinitions="*,Auto">
                    <Image Source="logo.png" HeightRequest="46" WidthRequest="160"
                           Aspect="AspectFit" HorizontalOptions="Start" VerticalOptions="Center" />

                    <Border Grid.Column="1" WidthRequest="46" HeightRequest="46"
                            StrokeShape="Ellipse" StrokeThickness="0"
                            BackgroundColor="#E6EBF4" VerticalOptions="Center">
                        <Image Source="ic_bell.png" WidthRequest="22" HeightRequest="22"
                               HorizontalOptions="Center" VerticalOptions="Center" />
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OpenNotificationsCommand}" />
                        </Border.GestureRecognizers>
                    </Border>
                </Grid>

                <!-- Greeting -->
                <VerticalStackLayout Spacing="2" Margin="0,-4,0,0">
                    <Label Text="Hello," TextColor="#DCE8F5" FontFamily="OpenSansRegular" FontSize="15" />
                    <Label Text="Welcome!" TextColor="White" FontFamily="OpenSansSemibold" FontSize="32" />
                    <Label Text="What would you like to book today?" TextColor="#DCE8F5"
                           FontFamily="OpenSansRegular" FontSize="13" />
                </VerticalStackLayout>

                <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"
                                   Color="White" HorizontalOptions="Center" />
                <Label Text="{Binding ErrorMessage}" TextColor="#FECACA" FontSize="13"
                       IsVisible="{Binding ErrorMessage, Converter={StaticResource IsNotNull}}" />

                <!-- Search bar + Filters button -->
                <Border BackgroundColor="White" StrokeThickness="0"
                        StrokeShape="RoundRectangle 28" Padding="18,0,8,0"
                        HeightRequest="54">
                    <Border.Shadow>
                        <Shadow Brush="Black" Opacity="0.2" Radius="14" Offset="0,5" />
                    </Border.Shadow>
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                        <Image Grid.Column="0" WidthRequest="20" HeightRequest="20"
                               VerticalOptions="Center"
                               mi:MauiIcon.Value="{mi:Material Icon=Search, IconColor=#5B6B8C}" />

                        <Entry Grid.Column="1"
                               Placeholder="Search nails, lashes, press-ons..."
                               PlaceholderColor="#9AA5BC"
                               TextColor="#1B2A4A"
                               BackgroundColor="Transparent"
                               FontFamily="OpenSansRegular"
                               FontSize="14"
                               VerticalOptions="Center"
                               ReturnType="Done"
                               Text="{Binding SearchText}" />

                        <Border Grid.Column="2" BackgroundColor="#1B2A4A" StrokeThickness="0"
                                StrokeShape="RoundRectangle 20" Padding="14,0"
                                HeightRequest="38" VerticalOptions="Center">
                            <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                <Image WidthRequest="16" HeightRequest="16" VerticalOptions="Center"
                                       mi:MauiIcon.Value="{mi:Material Icon=Tune, IconColor=White}" />
                                <Label Text="{Binding FilterButtonText}" FontFamily="OpenSansSemibold"
                                       FontSize="13" TextColor="White" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ToggleFilterPanelCommand}" />
                            </Border.GestureRecognizers>
                        </Border>
                    </Grid>
                </Border>

                <!-- Filter panel (opens in place, nothing navigates away) -->
                <Border IsVisible="{Binding IsFilterPanelOpen}"
                        BackgroundColor="White" StrokeThickness="0"
                        StrokeShape="RoundRectangle 24" Padding="18">
                    <Border.Shadow>
                        <Shadow Brush="Black" Opacity="0.2" Radius="14" Offset="0,5" />
                    </Border.Shadow>
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Show" Style="{StaticResource FilterHeading}" Margin="0,0,0,2" />
                        <FlexLayout Wrap="Wrap"
                                    BindableLayout.ItemsSource="{Binding TypeChips}"
                                    BindableLayout.ItemTemplate="{StaticResource FilterChipTemplate}" />

                        <Label Text="Category" Style="{StaticResource FilterHeading}" />
                        <FlexLayout Wrap="Wrap"
                                    BindableLayout.ItemsSource="{Binding CategoryChips}"
                                    BindableLayout.ItemTemplate="{StaticResource FilterChipTemplate}" />

                        <Label Text="Price" Style="{StaticResource FilterHeading}" />
                        <FlexLayout Wrap="Wrap"
                                    BindableLayout.ItemsSource="{Binding PriceChips}"
                                    BindableLayout.ItemTemplate="{StaticResource FilterChipTemplate}" />

                        <Label Text="Sort by" Style="{StaticResource FilterHeading}" />
                        <FlexLayout Wrap="Wrap"
                                    BindableLayout.ItemsSource="{Binding SortChips}"
                                    BindableLayout.ItemTemplate="{StaticResource FilterChipTemplate}" />

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,8,0,0">
                            <Button Text="Clear all" Command="{Binding ClearFiltersCommand}"
                                    BackgroundColor="Transparent" TextColor="#1B2A4A"
                                    BorderColor="#1B2A4A" BorderWidth="1" CornerRadius="14"
                                    FontFamily="OpenSansSemibold" HeightRequest="46" />
                            <Button Grid.Column="1" Text="Show results"
                                    Command="{Binding ToggleFilterPanelCommand}"
                                    BackgroundColor="#1B2A4A" TextColor="White" CornerRadius="14"
                                    FontFamily="OpenSansSemibold" HeightRequest="46" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Category shortcuts (these filter this page too) -->
                <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                    <HorizontalStackLayout Spacing="14"
                                           BindableLayout.ItemsSource="{Binding Categories}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:HomeCategory">
                                <VerticalStackLayout Spacing="8" WidthRequest="72">
                                    <Border WidthRequest="62" HeightRequest="62"
                                            StrokeShape="Ellipse" StrokeThickness="2" Stroke="#40FFFFFF"
                                            BackgroundColor="{Binding Background}"
                                            HorizontalOptions="Center">
                                        <Label Text="{Binding Glyph}" FontSize="24"
                                               HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Border>
                                    <Label Text="{Binding Label}" TextColor="White"
                                           FontFamily="OpenSansRegular" FontSize="12"
                                           HorizontalTextAlignment="Center"
                                           LineBreakMode="TailTruncation" />
                                    <VerticalStackLayout.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnCategoryTapped" />
                                    </VerticalStackLayout.GestureRecognizers>
                                </VerticalStackLayout>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </HorizontalStackLayout>
                </ScrollView>

                <!-- ============ RESULTS (shown while searching / filtering) ============ -->
                <VerticalStackLayout IsVisible="{Binding IsFiltering}" Spacing="14">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="{Binding ResultSummary}" Style="{StaticResource SectionTitle}" />
                        <Border Grid.Column="1" BackgroundColor="#33FFFFFF" StrokeThickness="0"
                                StrokeShape="RoundRectangle 14" Padding="14,6" VerticalOptions="Center">
                            <Label Text="Clear" Style="{StaticResource ViewAll}" />
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ClearFiltersCommand}" />
                            </Border.GestureRecognizers>
                        </Border>
                    </Grid>

                    <Label Text="No matches found. Try a different search or clear the filters."
                           TextColor="White" FontFamily="OpenSansRegular" FontSize="14"
                           IsVisible="{Binding HasNoResults}" />

                    <Label Text="Services" Style="{StaticResource ResultHeading}"
                           IsVisible="{Binding HasServiceResults}" />
                    <VerticalStackLayout Spacing="12"
                                         IsVisible="{Binding HasServiceResults}"
                                         BindableLayout.ItemsSource="{Binding ResultServices}"
                                         BindableLayout.ItemTemplate="{StaticResource ServiceRowTemplate}" />

                    <Label Text="Products" Style="{StaticResource ResultHeading}"
                           IsVisible="{Binding HasProductResults}" />
                    <FlexLayout Wrap="Wrap" JustifyContent="SpaceBetween" AlignItems="Start"
                                IsVisible="{Binding HasProductResults}"
                                BindableLayout.ItemsSource="{Binding ResultProducts}"
                                BindableLayout.ItemTemplate="{StaticResource ProductCardTemplate}" />
                </VerticalStackLayout>

                <!-- ============ DEFAULT HOME (hidden while searching / filtering) ============ -->
                <VerticalStackLayout IsVisible="{Binding IsNotFiltering}" Spacing="22">

                    <!-- Promo banner -->
                    <Border StrokeThickness="0" StrokeShape="RoundRectangle 28"
                            HeightRequest="170" Padding="0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#F7F8FC" Offset="0.0" />
                                <GradientStop Color="#B9C9EA" Offset="1.0" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.Shadow>
                            <Shadow Brush="Black" Opacity="0.22" Radius="16" Offset="0,6" />
                        </Border.Shadow>

                        <Grid>
                            <!-- Decorative circles -->
                            <Ellipse Fill="#40FFFFFF" WidthRequest="170" HeightRequest="170"
                                     HorizontalOptions="End" VerticalOptions="Start"
                                     Margin="0,-60,-50,0" />
                            <Ellipse Fill="#26FFFFFF" WidthRequest="110" HeightRequest="110"
                                     HorizontalOptions="Start" VerticalOptions="End"
                                     Margin="-30,0,0,-40" />

                            <Grid RowDefinitions="Auto,*" Padding="20">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <Border BackgroundColor="#1B2A4A" StrokeThickness="0"
                                            StrokeShape="RoundRectangle 14" Padding="12,6">
                                        <Label Text="SUMMER SALE" TextColor="White"
                                               FontFamily="OpenSansSemibold" FontSize="11" />
                                    </Border>

                                    <Border Grid.Column="2" BackgroundColor="White" StrokeThickness="0"
                                            StrokeShape="RoundRectangle 18" Padding="16,9">
                                        <Label Text="Shop now  →" TextColor="#1B2A4A"
                                               FontFamily="OpenSansSemibold" FontSize="13" />
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding ShopNowCommand}" />
                                        </Border.GestureRecognizers>
                                    </Border>
                                </Grid>

                                <VerticalStackLayout Grid.Row="1" VerticalOptions="End" Spacing="2">
                                    <Label Text="Summer Nail Sale" TextColor="#1B2A4A"
                                           FontFamily="OpenSansSemibold" FontSize="24" />
                                    <Label Text="Up to 40% off select services" TextColor="#4D6893"
                                           FontFamily="OpenSansRegular" FontSize="13" />
                                </VerticalStackLayout>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Trending Styles -->
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Trending Styles" Style="{StaticResource SectionTitle}" />
                        <Border Grid.Column="1" BackgroundColor="#33FFFFFF" StrokeThickness="0"
                                StrokeShape="RoundRectangle 14" Padding="14,6" VerticalOptions="Center">
                            <Label Text="View all" Style="{StaticResource ViewAll}" />
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ViewAllTrendingCommand}" />
                            </Border.GestureRecognizers>
                        </Border>
                    </Grid>

                    <FlexLayout Wrap="Wrap" JustifyContent="SpaceBetween" AlignItems="Start"
                                BindableLayout.ItemsSource="{Binding TrendingServices}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:HomeServiceCard">
                                <Border FlexLayout.Basis="47%" BackgroundColor="White"
                                        StrokeThickness="0" StrokeShape="RoundRectangle 22"
                                        Padding="10" Margin="0,0,0,14">
                                    <Border.Shadow>
                                        <Shadow Brush="Black" Opacity="0.18" Radius="12" Offset="0,4" />
                                    </Border.Shadow>
                                    <VerticalStackLayout Spacing="8">
                                        <Border HeightRequest="120" StrokeThickness="0"
                                                StrokeShape="RoundRectangle 16" BackgroundColor="#E6EBF4">
                                            <Image Source="{Binding ImageUrl}" Aspect="AspectFill" />
                                        </Border>
                                        <VerticalStackLayout Spacing="2" Padding="4,0,4,4">
                                            <Label Text="{Binding Name}" Style="{StaticResource CardTitle}" />
                                            <Label Text="{Binding PriceSubtitle}" Style="{StaticResource CardSubtitle}" />
                                        </VerticalStackLayout>
                                    </VerticalStackLayout>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnServiceTapped" />
                                    </Border.GestureRecognizers>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </FlexLayout>

                    <!-- New Arrival Press-Ons -->
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="New Arrival Press-Ons" Style="{StaticResource SectionTitle}" />
                        <Border Grid.Column="1" BackgroundColor="#33FFFFFF" StrokeThickness="0"
                                StrokeShape="RoundRectangle 14" Padding="14,6" VerticalOptions="Center">
                            <Label Text="View all" Style="{StaticResource ViewAll}" />
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ViewAllNewArrivalsCommand}" />
                            </Border.GestureRecognizers>
                        </Border>
                    </Grid>

                    <FlexLayout Wrap="Wrap" JustifyContent="SpaceBetween" AlignItems="Start"
                                BindableLayout.ItemsSource="{Binding NewArrivals}"
                                BindableLayout.ItemTemplate="{StaticResource ProductCardTemplate}" />

                    <!-- Popular Services -->
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Popular Services" Style="{StaticResource SectionTitle}" />
                        <Border Grid.Column="1" BackgroundColor="#33FFFFFF" StrokeThickness="0"
                                StrokeShape="RoundRectangle 14" Padding="14,6" VerticalOptions="Center">
                            <Label Text="View all" Style="{StaticResource ViewAll}" />
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ViewAllPopularCommand}" />
                            </Border.GestureRecognizers>
                        </Border>
                    </Grid>

                    <VerticalStackLayout Spacing="12"
                                         BindableLayout.ItemsSource="{Binding PopularServices}"
                                         BindableLayout.ItemTemplate="{StaticResource ServiceRowTemplate}" />
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>