<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:svc="clr-namespace:SBSBeautySpa.Mobile.Services"
             xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
             x:Class="SBSBeautySpa.Mobile.Views.Admin.AdminStaffPage"
             x:Name="ThisPage"
             Shell.NavBarIsVisible="False">

    <Grid Background="{StaticResource PageGradient}"
          RowDefinitions="Auto,Auto,Auto,Auto,*" Padding="20,50,20,0" RowSpacing="12">

        <!-- Header: same arrow icon as the other admin pages (white on the purple background) -->
        <HorizontalStackLayout Grid.Row="0" Spacing="14">
            <Image WidthRequest="26" HeightRequest="26" VerticalOptions="Center"
                   mi:MauiIcon.Value="{mi:Material Icon=ArrowBack, IconColor=White}">
                <Image.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnBackTapped" />
                </Image.GestureRecognizers>
            </Image>
            <Label Text="Manage Staff" FontFamily="OpenSansSemibold"
                   FontSize="24" TextColor="White" VerticalOptions="Center" />
        </HorizontalStackLayout>

        <!-- Count pill -->
        <Border Grid.Row="1" HorizontalOptions="Start" BackgroundColor="#33FFFFFF"
                StrokeThickness="0" StrokeShape="RoundRectangle 14" Padding="14,6">
            <Label Text="{Binding Staff.Count, StringFormat='{0} staff members'}"
                   FontFamily="OpenSansRegular" FontSize="12" TextColor="White" />
        </Border>

        <!-- Shown to regular admins: staff can only be changed by a super admin -->
        <Border Grid.Row="2" IsVisible="{Binding IsNotSuperAdmin, Source={x:Reference ThisPage}}"
                BackgroundColor="#FFF4E5" StrokeThickness="0" StrokeShape="RoundRectangle 18" Padding="14,12">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                <Image WidthRequest="22" HeightRequest="22" VerticalOptions="Start"
                       mi:MauiIcon.Value="{mi:Material Icon=Lock, IconColor=#B45309}" />
                <VerticalStackLayout Grid.Column="1" Spacing="2">
                    <Label Text="Super admin only" FontFamily="OpenSansSemibold"
                           FontSize="14" TextColor="#92400E" />
                    <Label Text="You are not a super admin, so you cannot edit staff. Only a super admin can promote or demote staff."
                           FontFamily="OpenSansRegular" FontSize="12" TextColor="#92400E" />
                </VerticalStackLayout>
            </Grid>
        </Border>

        <!-- Add staff (super admins only) + messages -->
        <VerticalStackLayout Grid.Row="3" Spacing="10">
            <Border IsVisible="{Binding IsSuperAdmin, Source={x:Reference ThisPage}}"
                    BackgroundColor="White" StrokeThickness="0" StrokeShape="RoundRectangle 20" Padding="14">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Add staff member" FontFamily="OpenSansSemibold"
                           FontSize="15" TextColor="#2B1B6B" />
                    <Label Text="Enter the email of someone who has already registered in the app."
                           FontFamily="OpenSansRegular" FontSize="12" TextColor="#6E63A6" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <Border BackgroundColor="#EFE9FF" StrokeThickness="0"
                                StrokeShape="RoundRectangle 22" Padding="16,0" HeightRequest="44">
                            <Entry Placeholder="staff@email.com" PlaceholderColor="#A59CC9"
                                   TextColor="#2B1B6B" FontFamily="OpenSansRegular" FontSize="14"
                                   BackgroundColor="Transparent" Keyboard="Email"
                                   VerticalOptions="Center" ReturnType="Done"
                                   Text="{Binding NewStaffEmail}" />
                        </Border>
                        <Button Grid.Column="1" Text="Add" FontFamily="OpenSansSemibold" FontSize="14"
                                HeightRequest="44" WidthRequest="84" CornerRadius="22"
                                BackgroundColor="#6D3FE0" TextColor="White"
                                Command="{Binding AddStaffCommand}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"
                               Color="White" HorizontalOptions="Center" />

            <Label Text="{Binding ErrorMessage}" TextColor="#FECACA" FontFamily="OpenSansRegular" FontSize="13"
                   IsVisible="{Binding ErrorMessage, Converter={StaticResource IsNotNull}}" />
            <Label Text="{Binding InfoMessage}" TextColor="#BBF7D0" FontFamily="OpenSansSemibold" FontSize="13"
                   IsVisible="{Binding InfoMessage, Converter={StaticResource IsNotNull}}" />
        </VerticalStackLayout>

        <!-- Staff list -->
        <CollectionView Grid.Row="4" ItemsSource="{Binding Staff}">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="8" />
            </CollectionView.ItemsLayout>

            <CollectionView.EmptyView>
                <Label Text="No staff yet." TextColor="White" FontFamily="OpenSansRegular"
                       HorizontalOptions="Center" Margin="0,40,0,0" />
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="svc:AdminUser">
                    <Border BackgroundColor="White" StrokeThickness="0"
                            StrokeShape="RoundRectangle 20" Padding="14">
                        <VerticalStackLayout Spacing="12">

                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                <!-- Avatar -->
                                <Border WidthRequest="42" HeightRequest="42" StrokeShape="Ellipse"
                                        StrokeThickness="0" BackgroundColor="#EFE9FF"
                                        VerticalOptions="Center">
                                    <Image WidthRequest="22" HeightRequest="22"
                                           HorizontalOptions="Center" VerticalOptions="Center"
                                           mi:MauiIcon.Value="{mi:Material Icon=Person, IconColor=#6D3FE0}" />
                                </Border>

                                <Label Grid.Column="1"
                                       Text="{Binding Email, FallbackValue='(no email)'}"
                                       FontFamily="OpenSansSemibold" FontSize="14"
                                       TextColor="#2B1B6B" VerticalOptions="Center"
                                       LineBreakMode="TailTruncation" />

                                <Border Grid.Column="2" Padding="10,5" BackgroundColor="#EFE9FF"
                                        StrokeThickness="0" StrokeShape="RoundRectangle 12"
                                        VerticalOptions="Center">
                                    <Label Text="Staff"
                                           FontFamily="OpenSansSemibold" FontSize="11"
                                           TextColor="#6D3FE0">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding SuperAdmin}" Value="True">
                                                <Setter Property="Text" Value="Super admin" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                </Border>
                            </Grid>

                            <BoxView HeightRequest="1" Color="#ECE8F7"
                                 IsVisible="{Binding IsSuperAdmin, Source={x:Reference ThisPage}}" />

                            <Grid ColumnDefinitions="*,*" ColumnSpacing="10"
                                  IsVisible="{Binding IsSuperAdmin, Source={x:Reference ThisPage}}">
                                <!-- Everyone in this list is staff, so the first button removes them. -->
                                <Button Text="Remove from staff" FontFamily="OpenSansSemibold"
                                        FontSize="12" HeightRequest="40"
                                        BackgroundColor="White" TextColor="#D92D20"
                                        BorderColor="#D92D20" BorderWidth="1" CornerRadius="20"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.ToggleAdminCommand}"
                                        CommandParameter="{Binding .}">
                                    <Button.Triggers>
                                        <DataTrigger TargetType="Button" Binding="{Binding Admin}" Value="False">
                                            <Setter Property="Text" Value="Make staff" />
                                            <Setter Property="TextColor" Value="#6D3FE0" />
                                            <Setter Property="BorderColor" Value="#6D3FE0" />
                                        </DataTrigger>
                                    </Button.Triggers>
                                </Button>
                                <Button Grid.Column="1" Text="Make super admin"
                                        FontFamily="OpenSansSemibold" FontSize="12" HeightRequest="40"
                                        BackgroundColor="#6D3FE0" TextColor="White" CornerRadius="20"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.ToggleSuperAdminCommand}"
                                        CommandParameter="{Binding .}">
                                    <Button.Triggers>
                                        <DataTrigger TargetType="Button" Binding="{Binding SuperAdmin}" Value="True">
                                            <Setter Property="Text" Value="Remove super admin" />
                                            <Setter Property="BackgroundColor" Value="#8B7FC7" />
                                        </DataTrigger>
                                    </Button.Triggers>
                                </Button>
                            </Grid>

                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>
</ContentPage>
