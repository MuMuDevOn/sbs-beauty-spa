<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:svc="clr-namespace:SBSBeautySpa.Mobile.Services"
             xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
             x:Class="SBSBeautySpa.Mobile.Views.Admin.AdminStaffPage"
             BackgroundColor="White"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,Auto,*" Padding="20,50,20,0" RowSpacing="12">

        <HorizontalStackLayout Grid.Row="0" Spacing="14">
            <Image WidthRequest="26" HeightRequest="26"
                   mi:MauiIcon.Value="{mi:Material Icon=ArrowBack, IconColor=Black}">
                <Image.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnBackTapped"/>
                </Image.GestureRecognizers>
            </Image>
            <Label Text="Manage Staff" FontFamily="OpenSansSemibold" FontSize="20"
                   TextColor="Black" VerticalOptions="Center"/>
        </HorizontalStackLayout>

        <Label Grid.Row="1" Text="{Binding Staff.Count, StringFormat='{0} staff members'}"
               FontSize="12" TextColor="#6B7280"/>

        <CollectionView Grid.Row="2" ItemsSource="{Binding Staff}">
            <CollectionView.EmptyView>
                <Label Text="No staff yet." TextColor="#9CA3AF"
                       HorizontalOptions="Center" Margin="0,40,0,0"/>
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="svc:AdminUser">
                    <Border BackgroundColor="White" Stroke="#E5E7EB" StrokeThickness="1"
                            StrokeShape="RoundRectangle 10" Padding="14" Margin="0,0,0,10">
                        <VerticalStackLayout Spacing="10">

                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="{Binding Email, FallbackValue='(no email)'}"
                                       FontFamily="OpenSansSemibold" FontSize="14"
                                       TextColor="#111827" VerticalOptions="Center"/>

                                <Border Grid.Column="1" Padding="10,4"
                                        BackgroundColor="#E5E7EB"
                                        StrokeThickness="0" StrokeShape="RoundRectangle 6">
                                    <Label Text="{Binding SuperAdmin, StringFormat='Super: {0}'}"
                                           FontSize="10" TextColor="#4B5563"/>
                                </Border>
                            </Grid>

                            <BoxView HeightRequest="1" Color="#E5E7EB"/>

                            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                <Button Text="Toggle Admin" FontSize="12" HeightRequest="38"
                                        BackgroundColor="White" TextColor="Black"
                                        BorderColor="#D1D5DB" BorderWidth="1" CornerRadius="8"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.ToggleAdminCommand}"
                                        CommandParameter="{Binding .}"/>
                                <Button Grid.Column="1" Text="Toggle Super Admin" FontSize="12" HeightRequest="38"
                                        BackgroundColor="#111827" TextColor="White"
                                        CornerRadius="8"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.ToggleSuperAdminCommand}"
                                        CommandParameter="{Binding .}"/>
                            </Grid>

                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>
</ContentPage>