<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
             xmlns:models="clr-namespace:SBSBeautySpa.Mobile.Models"
             x:Class="SBSBeautySpa.Mobile.Views.Admin.AdminServicesPage"
             x:Name="ThisPage"
             Background="{StaticResource PageGradient}"
             Shell.NavBarIsVisible="False">

    <ContentPage.Resources>
        <!-- Rounded lilac box that holds a text field -->
        <Style x:Key="FieldBox" TargetType="Border">
            <Setter Property="BackgroundColor" Value="#EFE9FF"/>
            <Setter Property="StrokeThickness" Value="0"/>
            <Setter Property="StrokeShape" Value="RoundRectangle 22"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="HeightRequest" Value="44"/>
        </Style>
        <Style x:Key="FieldEntry" TargetType="Entry">
            <Setter Property="BackgroundColor" Value="Transparent"/>
            <Setter Property="TextColor" Value="#2B1B6B"/>
            <Setter Property="PlaceholderColor" Value="#A59CC9"/>
            <Setter Property="FontFamily" Value="OpenSansRegular"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalOptions" Value="Center"/>
        </Style>
        <Style x:Key="FieldCaption" TargetType="Label">
            <Setter Property="FontFamily" Value="OpenSansSemibold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextColor" Value="#6E63A6"/>
            <Setter Property="Margin" Value="4,2,0,-4"/>
        </Style>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,Auto,*" Padding="20,50,20,0" RowSpacing="12">

        <!-- Header -->
        <HorizontalStackLayout Grid.Row="0" Spacing="14">
            <Image WidthRequest="26" HeightRequest="26" VerticalOptions="Center"
                   mi:MauiIcon.Value="{mi:Material Icon=ArrowBack, IconColor=White}">
                <Image.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnBackTapped"/>
                </Image.GestureRecognizers>
            </Image>
            <Label Text="Manage Services" FontFamily="OpenSansSemibold" FontSize="24"
                   TextColor="White" VerticalOptions="Center"/>
        </HorizontalStackLayout>

        <!-- Add button (opens / closes the form) -->
        <Button Grid.Row="1" Text="{Binding AddButtonText}" BackgroundColor="White"
                TextColor="#6D3FE0" FontFamily="OpenSansSemibold" FontSize="14"
                CornerRadius="22" HeightRequest="44"
                Command="{Binding ToggleNewServiceCommand}"/>

        <!-- Content: editor + list inside a scroll view -->
        <ScrollView Grid.Row="2">
            <VerticalStackLayout Spacing="12">

                <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"
                                   Color="White" HorizontalOptions="Center"/>

                <!-- Messages stay visible even when the form is closed -->
                <Label Text="{Binding ErrorMessage}" TextColor="#FECACA"
                       FontFamily="OpenSansRegular" FontSize="13"
                       IsVisible="{Binding ErrorMessage, Converter={StaticResource IsNotNull}}"/>
                <Label Text="{Binding InfoMessage}" TextColor="#BBF7D0"
                       FontFamily="OpenSansSemibold" FontSize="13"
                       IsVisible="{Binding InfoMessage, Converter={StaticResource IsNotNull}}"/>

                <!-- Editor panel (drops down) -->
                <Border BackgroundColor="White" StrokeThickness="0"
                        StrokeShape="RoundRectangle 20" Padding="16"
                        IsVisible="{Binding IsEditorOpen}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="{Binding EditorTitle}" FontFamily="OpenSansSemibold"
                               FontSize="16" TextColor="#2B1B6B"/>

                        <Border Style="{StaticResource FieldBox}">
                            <Entry Style="{StaticResource FieldEntry}" Placeholder="Service name"
                                   Text="{Binding DraftName}"/>
                        </Border>
                        <Border Style="{StaticResource FieldBox}">
                            <Entry Style="{StaticResource FieldEntry}" Placeholder="Description"
                                   Text="{Binding DraftDescription}"/>
                        </Border>
                        <Border Style="{StaticResource FieldBox}">
                            <Entry Style="{StaticResource FieldEntry}"
                                   Placeholder="Category (nails, lashes, press-ons)"
                                   Text="{Binding DraftCategoryId}"/>
                        </Border>

                        <Label Text="Price (R)" Style="{StaticResource FieldCaption}"/>
                        <Border Style="{StaticResource FieldBox}">
                            <Entry Style="{StaticResource FieldEntry}" Placeholder="Price" Keyboard="Numeric"
                                   Text="{Binding DraftPrice}"/>
                        </Border>

                        <Label Text="Deposit (R)" Style="{StaticResource FieldCaption}"/>
                        <Border Style="{StaticResource FieldBox}">
                            <Entry Style="{StaticResource FieldEntry}" Placeholder="Deposit" Keyboard="Numeric"
                                   Text="{Binding DraftDepositAmount}"/>
                        </Border>

                        <Label Text="Duration (minutes)" Style="{StaticResource FieldCaption}"/>
                        <Border Style="{StaticResource FieldBox}">
                            <Entry Style="{StaticResource FieldEntry}" Placeholder="Duration (minutes)"
                                   Keyboard="Numeric" Text="{Binding DraftDurationMinutes}"/>
                        </Border>

                        <Label Text="Buffer after booking (minutes)" Style="{StaticResource FieldCaption}"/>
                        <Border Style="{StaticResource FieldBox}">
                            <Entry Style="{StaticResource FieldEntry}" Placeholder="Buffer (minutes)"
                                   Keyboard="Numeric" Text="{Binding DraftBufferMinutes}"/>
                        </Border>

                        <!-- Photo from the device -->
                        <Label Text="Service photo" FontFamily="OpenSansSemibold"
                               FontSize="13" TextColor="#2B1B6B" Margin="0,4,0,0"/>

                        <Border HeightRequest="150" BackgroundColor="#EFE9FF"
                                Stroke="#CFC4F5" StrokeThickness="1" StrokeDashArray="4,4"
                                StrokeShape="RoundRectangle 16">
                            <Grid>
                                <Image Source="{Binding DraftImageUrl}" Aspect="AspectFill"
                                       IsVisible="{Binding HasImage}"/>
                                <Label Text="No photo yet" TextColor="#8A80B8"
                                       FontFamily="OpenSansRegular" FontSize="13"
                                       HorizontalOptions="Center" VerticalOptions="Center"
                                       IsVisible="{Binding HasNoImage}"/>
                                <ActivityIndicator IsRunning="{Binding IsUploading}"
                                                   IsVisible="{Binding IsUploading}"
                                                   Color="#6D3FE0"
                                                   HorizontalOptions="Center" VerticalOptions="Center"/>
                            </Grid>
                        </Border>

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <Button Text="Upload photo" FontFamily="OpenSansSemibold" FontSize="13"
                                    HeightRequest="42" CornerRadius="21"
                                    BackgroundColor="White" TextColor="#6D3FE0"
                                    BorderColor="#6D3FE0" BorderWidth="1"
                                    Command="{Binding PickPhotoCommand}"/>
                            <Button Grid.Column="1" Text="Remove" FontFamily="OpenSansSemibold"
                                    FontSize="13" HeightRequest="42" CornerRadius="21"
                                    Padding="18,0"
                                    BackgroundColor="White" TextColor="#B3261E"
                                    BorderColor="#E5D5D5" BorderWidth="1"
                                    IsVisible="{Binding HasImage}"
                                    Command="{Binding RemovePhotoCommand}"/>
                        </Grid>

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8" Margin="0,6,0,0">
                            <Button Text="Save" Command="{Binding SaveCommand}"
                                    FontFamily="OpenSansSemibold" FontSize="14"
                                    BackgroundColor="#6D3FE0" TextColor="White"
                                    CornerRadius="22" HeightRequest="44"/>
                            <Button Grid.Column="1" Text="Cancel"
                                    Command="{Binding StartNewServiceCommand}"
                                    FontFamily="OpenSansSemibold" FontSize="14"
                                    BackgroundColor="White" TextColor="#6D3FE0"
                                    BorderColor="#6D3FE0" BorderWidth="1"
                                    CornerRadius="22" HeightRequest="44"/>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Services list -->
                <CollectionView ItemsSource="{Binding Services}" SelectionMode="None">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Vertical" ItemSpacing="8"/>
                    </CollectionView.ItemsLayout>

                    <CollectionView.EmptyView>
                        <Label Text="No services yet." TextColor="White" Opacity="0.85"
                               FontFamily="OpenSansRegular" FontSize="14"
                               HorizontalOptions="Start" Margin="0,16,0,0"/>
                    </CollectionView.EmptyView>

                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:Service">
                            <Border BackgroundColor="White" StrokeThickness="0"
                                    StrokeShape="RoundRectangle 20" Padding="14">
                                <VerticalStackLayout Spacing="12">

                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                        <Border WidthRequest="52" HeightRequest="52" BackgroundColor="#EFE9FF"
                                                StrokeThickness="0" StrokeShape="RoundRectangle 12">
                                            <Image Source="{Binding ImageUrl}" Aspect="AspectFill"/>
                                        </Border>

                                        <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                                            <Label Text="{Binding Name}" FontFamily="OpenSansSemibold"
                                                   FontSize="14" TextColor="#2B1B6B"/>
                                            <HorizontalStackLayout Spacing="8">
                                                <Border BackgroundColor="#EFE9FF" StrokeThickness="0"
                                                        StrokeShape="RoundRectangle 10" Padding="8,3">
                                                    <Label Text="{Binding CategoryId}"
                                                           FontFamily="OpenSansSemibold"
                                                           FontSize="10" TextColor="#6D3FE0"/>
                                                </Border>
                                                <Label Text="{Binding DurationMinutes, StringFormat='{0} min'}"
                                                       FontFamily="OpenSansRegular"
                                                       FontSize="11" TextColor="#9A93BF"
                                                       VerticalOptions="Center"/>
                                            </HorizontalStackLayout>
                                        </VerticalStackLayout>

                                        <Label Grid.Column="2" Text="{Binding Price, StringFormat='R{0:0.00}'}"
                                               FontFamily="OpenSansSemibold" FontSize="14"
                                               TextColor="#6D3FE0" VerticalOptions="Start"/>
                                    </Grid>

                                    <BoxView HeightRequest="1" Color="#ECE8F7"/>

                                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                                        <Button Grid.Column="0" Text="Edit"
                                                FontFamily="OpenSansSemibold" FontSize="12"
                                                BackgroundColor="White" TextColor="#6D3FE0"
                                                BorderColor="#6D3FE0" BorderWidth="1"
                                                CornerRadius="18" HeightRequest="36"
                                                Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.SelectForEditCommand}"
                                                CommandParameter="{Binding .}"/>
                                        <Button Grid.Column="1"
                                                Text="{Binding IsActive, StringFormat='Active: {0}'}"
                                                FontFamily="OpenSansSemibold" FontSize="12"
                                                BackgroundColor="#6D3FE0" TextColor="White"
                                                CornerRadius="18" HeightRequest="36"
                                                Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.ToggleActiveCommand}"
                                                CommandParameter="{Binding .}"/>
                                        <Button Grid.Column="2" Text="Delete"
                                                FontFamily="OpenSansSemibold" FontSize="12"
                                                BackgroundColor="White" TextColor="#B3261E"
                                                BorderColor="#E5D5D5" BorderWidth="1"
                                                CornerRadius="18" HeightRequest="36"
                                                Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.DeleteCommand}"
                                                CommandParameter="{Binding .}"/>
                                    </Grid>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <BoxView HeightRequest="20" Color="Transparent"/>
            </VerticalStackLayout>
        </ScrollView>

    </Grid>
</ContentPage>
