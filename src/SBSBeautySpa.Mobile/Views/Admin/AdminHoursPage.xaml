<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
             x:Class="SBSBeautySpa.Mobile.Views.Admin.AdminHoursPage"
             x:Name="ThisPage"
             BackgroundColor="White"
             Shell.NavBarIsVisible="False">


    <Grid RowDefinitions="Auto,*,Auto" Padding="20,50,20,16">

        <!--Header-->
        <HorizontalStackLayout Spacing="14">
            <Image WidthRequest="26" HeightRequest="26"
            mi:MauiIcon.Value="{mi:Material Icon = ArrowBack, IconColor= Black}">
                <Image.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnBackTapped"/>
                </Image.GestureRecognizers>
            </Image>
            <Label Text=" Business Hours" FontFamily="OpenSansSemibold" FontSize="20"
             TextColor="Black" VerticalOptions="Center"/>
        </HorizontalStackLayout>
        
        <!--Scrollable middle-->
        <ScrollView Grid.Row=" 1">
            <VerticalStackLayout Spacing="8">
                <Label Text=" Set your default weekly availabiltiy" FontSize="12" TextColor="#6B7280"/>

                <VerticalStackLayout Spacing= "6" BindableLayout.ItemsSource="{Binding Days}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate>
                            <Border BackgroundColor="White" Stroke="#E5E7EB" StrokeThickness="1"
                                    StrokeShape="RoundRectangle 8" Padding="12,6">
                                <Grid ColumnDefinitions="105, Auto,*" ColumnSpacing="8">
                                    <Label Text="{Binding Name}" FontFamily="OpenSansSemibold"
                                           FontSize= "13" TextColor="Black" VerticalOptions="Center"/>

                                    <Switch Grid.Column="1" IsToggled="{Binding IsOpen}"
                                            OnColor="Black" VerticalOptions="Center"/>

                                    <HorizontalStackLayout Grid.Column="2" Spacing="4"
                                                           HorizontalOptions="End"
                                                           IsVisible="{Binding IsOpen}">
                                        <TimePicker Time="{Binding Open}" Format="h:mm:tt"
                                                    FontSize="12" TextColor="Black"/>
                                        <Label Text="-" VerticalOptions="Center" TextColor="#9CA3AF"/>
                                        <TimePicker Time="{Binding Close}" Format="h:mm:tt"
                                                    FontSize="12" TextColor="Black"/>
                                    </HorizontalStackLayout>

                                    <Label Grid.Column="2" Text=" Closed" FontSize="12"
                                           TextColor="#9CA3AF" HorizontalOptions="End"
                                           VerticalOptions="Center"
                                           IsVisible="{Binding IsClosed}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <Label Text="Special Closures &amp; Holidays" FontFamily="OpenSansSemibold"
                       FontSize="13" TextColor="Black" Margin="0,10,0,0"/>

                <Border Stroke="#D1D5DB" StrokeThickness="1" StrokeDashArray="4,3"
                        StrokeShape="RoundRectangle 8" Padding=" 12">
                    <Label Text="+ Add Custom Closure Date" FontSize="12" TextColor="#4B5563"
                           HorizontalOptions="Center"/>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer
                            Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.AddClosureCommand}"/>
                    </Border.GestureRecognizers>
                </Border>
            </VerticalStackLayout>
        </ScrollView> 
        
        <!--Save Button-->
        <Button Grid.Row="2" Text="Save Changes" BackgroundColor="Black" TextColor="White"
                FontFamily="OpenSansSemibold" CornerRadius="8" HeightRequest="48" Margin="0,10,0,0"
                Command="{Binding SaveCommand}"/>
    </Grid>
</ContentPage>