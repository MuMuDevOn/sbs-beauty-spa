<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:SBSBeautySpa.Mobile.Models"
             x:Class="SBSBeautySpa.Mobile.Views.Admin.AdminBookingsPage"
             BackgroundColor="White"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,Auto,Auto,*" Padding="20,50,20,0" RowSpacing="12">

        <!-- Header -->
        <HorizontalStackLayout Grid.Row="0" Spacing="14">
            <Label Text="&#8592;" FontSize="24" TextColor="Black" VerticalOptions="Center">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnBackTapped"/>
                </Label.GestureRecognizers>
            </Label>
            <Label Text="Manage Bookings" FontFamily="OpenSansSemibold" FontSize="20"
                   TextColor="Black" VerticalOptions="Center"/>
        </HorizontalStackLayout>

        <!-- Status filter chips -->
        <ScrollView Grid.Row="1" Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
            <HorizontalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding StatusFilters}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="models:BookingStatusFilter">
                        <Border Padding="14,6" StrokeThickness="0" StrokeShape="RoundRectangle 14"
                                BackgroundColor="{Binding IsSelected, Converter={StaticResource BoolToColor}, ConverterParameter='#111827|#F3F4F6'}">
                            <Label Text="{Binding Label}" FontSize="12"
                                   TextColor="{Binding IsSelected, Converter={StaticResource BoolToColor}, ConverterParameter='White|#6B7280'}"/>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.SelectFilterCommand}"
                                                       CommandParameter="{Binding .}"/>
                            </Border.GestureRecognizers>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </HorizontalStackLayout>
        </ScrollView>

        <!-- Count -->
        <Label Grid.Row="2" Text="{Binding Bookings.Count, StringFormat='{0} bookings'}"
               FontSize="12" TextColor="#6B7280"/>

        <!-- Bookings list -->
        <CollectionView Grid.Row="3" ItemsSource="{Binding Bookings}">
            <CollectionView.EmptyView>
                <Label Text="No bookings right now." TextColor="#9CA3AF"
                       HorizontalOptions="Center" Margin="0,40,0,0"/>
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Booking">
                    <Border BackgroundColor="White" Stroke="#E5E7EB" StrokeThickness="1"
                            StrokeShape="RoundRectangle 10" Padding="14" Margin="0,0,0,10">
                        <VerticalStackLayout Spacing="8">

                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="{Binding ClientDisplayName, FallbackValue='Client'}"
                                       FontFamily="OpenSansSemibold" FontSize="15"
                                       TextColor="#111827" VerticalOptions="Center"/>
                                <Border Grid.Column="1" BackgroundColor="#E5E7EB" StrokeThickness="0"
                                        StrokeShape="RoundRectangle 6" Padding="10,4">
                                    <Label Text="{Binding Status}" FontFamily="OpenSansSemibold"
                                           FontSize="11" TextColor="#4B5563"/>
                                </Border>
                            </Grid>

                            <Label Text="{Binding ServiceId}" FontSize="12" TextColor="#4B5563"/>

                            <Label Text="{Binding Date, StringFormat='{0:ddd, dd MMM yyyy}'}"
                                   FontSize="12" TextColor="#111827"/>

                            <Label Text="{Binding StartTime, StringFormat='{0:HH:mm}'}"
                                   FontSize="12" TextColor="#111827"/>

                            <BoxView HeightRequest="1" Color="#E5E7EB"/>

                            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                                <Button Text="Confirm" FontSize="12" HeightRequest="36"
                                        BackgroundColor="#111827" TextColor="White" CornerRadius="8"
                                        IsVisible="{Binding Status, Converter={StaticResource IsPendingConverter}}"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.ConfirmBookingCommand}"
                                        CommandParameter="{Binding .}"/>
                                <Button Grid.Column="1" Text="Complete" FontSize="12" HeightRequest="36"
                                        BackgroundColor="White" TextColor="Black"
                                        BorderColor="#D1D5DB" BorderWidth="1" CornerRadius="8"
                                        IsVisible="{Binding Status, Converter={StaticResource IsConfirmedConverter}}"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.CompleteBookingCommand}"
                                        CommandParameter="{Binding .}"/>
                                <Button Grid.Column="2" Text="Cancel" FontSize="12" HeightRequest="36"
                                        BackgroundColor="White" TextColor="Black"
                                        BorderColor="#D1D5DB" BorderWidth="1" CornerRadius="8"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.CancelBookingCommand}"
                                        CommandParameter="{Binding .}"/>
                            </Grid>

                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>
</ContentPage>