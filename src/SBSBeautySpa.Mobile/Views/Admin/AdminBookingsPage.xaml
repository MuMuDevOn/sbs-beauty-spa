<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
             xmlns:models="clr-namespace:SBSBeautySpa.Mobile.Models"
             xmlns:vm="clr-namespace:SBSBeautySpa.Mobile.ViewModels.Admin"
             x:Class="SBSBeautySpa.Mobile.Views.Admin.AdminBookingsPage"
             Shell.NavBarIsVisible="False">

    <Grid Background="{StaticResource PageGradient}"
          RowDefinitions="Auto,Auto,Auto,Auto,*" Padding="20,50,20,0" RowSpacing="12">

        <!-- Header -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*" ColumnSpacing="12">
            <Image WidthRequest="28" HeightRequest="28" VerticalOptions="Center"
                   mi:MauiIcon.Value="{mi:Material Icon=ArrowBack, IconColor=White}">
                <Image.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnBackTapped" />
                </Image.GestureRecognizers>
            </Image>
            <Label Grid.Column="1" Text="Manage Bookings" Style="{StaticResource ScreenTitle}"
                   FontSize="26" VerticalOptions="Center" />
        </Grid>

        <!-- Status filter chips -->
        <ScrollView Grid.Row="1" Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
            <HorizontalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding StatusFilters}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="vm:BookingStatusFilter">
                        <Border Padding="16,8" StrokeThickness="0" StrokeShape="RoundRectangle 20"
                                BackgroundColor="{Binding IsSelected, Converter={StaticResource BoolToColor}, ConverterParameter='#6D3FE0|White'}">
                            <Label Text="{Binding Label}" FontSize="14"
                                   TextColor="{Binding IsSelected, Converter={StaticResource BoolToColor}, ConverterParameter='White|#2B1B6B'}"/>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.SelectFilterCommand}"
                                                      CommandParameter="{Binding .}"/>
                            </Border.GestureRecognizers>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </HorizontalStackLayout>
        </ScrollView>

        <!-- Count -->
        <Label Grid.Row="2" Text="{Binding Bookings.Count, StringFormat='{0} bookings'}"
               FontSize="13" TextColor="White" FontFamily="OpenSansSemibold"/>

        <!-- Loading / error -->
        <VerticalStackLayout Grid.Row="3" Spacing="6">
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"
                               Color="White" HorizontalOptions="Center" />
            <Label Text="{Binding ErrorMessage}" TextColor="#FECACA" FontSize="13"
                   IsVisible="{Binding ErrorMessage, Converter={StaticResource IsNotNull}}" />
        </VerticalStackLayout>

        <!-- Bookings list: one card per booking -->
        <ScrollView Grid.Row="4">
            <VerticalStackLayout Spacing="12" Padding="0,0,0,24">

                <Label Text="No bookings right now." TextColor="White" FontSize="15"
                       HorizontalOptions="Center" Margin="0,30,0,0"
                       IsVisible="{Binding HasNoBookings}" />

                <VerticalStackLayout Spacing="12" BindableLayout.ItemsSource="{Binding Bookings}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="models:Booking">
                            <Border Style="{StaticResource ActionCard}" Padding="14">
                                <VerticalStackLayout Spacing="8">

                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <Label Text="{Binding ClientDisplayName, FallbackValue='Client'}"
                                               Style="{StaticResource CardHeading}" VerticalOptions="Center"/>
                                        <Border Grid.Column="1" BackgroundColor="#EFE9FF" StrokeThickness="0"
                                                StrokeShape="RoundRectangle 10" Padding="10,4" VerticalOptions="Center">
                                            <Label Text="{Binding Status}" FontFamily="OpenSansSemibold"
                                                   FontSize="12" TextColor="#6D3FE0"/>
                                        </Border>
                                    </Grid>

                                    <Label Text="{Binding ServiceName}" Style="{StaticResource CardCaption}"/>
                                    <Label Text="{Binding Date, StringFormat='{0:ddd, dd MMM yyyy}'}" Style="{StaticResource CardCaption}"/>
                                    <Label Text="{Binding StartTime, StringFormat='{0:HH:mm}'}" Style="{StaticResource CardCaption}"/>

                                    <BoxView HeightRequest="1" Color="#E4DDFB"/>

                                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                                        <Button Text="Confirm" FontSize="12" HeightRequest="38"
                                                Style="{StaticResource PrimaryButton}"
                                                IsVisible="{Binding IsPending}"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.ConfirmBookingCommand}"
                                                CommandParameter="{Binding .}"/>
                                        <Button Grid.Column="1" Text="Complete" FontSize="12" HeightRequest="38"
                                                Style="{StaticResource OutlineButton}"
                                                IsVisible="{Binding IsConfirmed}"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.CompleteBookingCommand}"
                                                CommandParameter="{Binding .}"/>
                                        <Button Grid.Column="2" Text="Cancel" FontSize="12" HeightRequest="38"
                                                Style="{StaticResource OutlineButton}"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.CancelBookingCommand}"
                                                CommandParameter="{Binding .}"/>
                                    </Grid>

                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

    </Grid>
</ContentPage>
