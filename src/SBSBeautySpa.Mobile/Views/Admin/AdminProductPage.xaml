<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
             xmlns:models="clr-namespace:SBSBeautySpa.Mobile.Models"
             x:Class="SBSBeautySpa.Mobile.Views.Admin.AdminProductPage"
             x:Name="ThisPage"
             BackgroundColor="White"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,Auto,*" Padding="20,50,20,0" RowSpacing="12">

        <!-- Header -->
        <HorizontalStackLayout Grid.Row="0" Spacing="14">
            <Image WidthRequest="26" HeightRequest="26"
                   mi:MauiIcon.Value="{mi:Material Icon=ArrowBack, IconColor=Black}">
                <Image.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnBackTapped"/>
                </Image.GestureRecognizers>
            </Image>
            <Label Text="Manage Products" FontFamily="OpenSansSemibold" FontSize="20"
                   TextColor="Black" VerticalOptions="Center"/>
        </HorizontalStackLayout>

        <!-- Add button -->
        <Button Grid.Row="1" Text="+ Add New Product" BackgroundColor="White"
                TextColor="Black" BorderColor="Black" BorderWidth="1"
                FontFamily="OpenSansSemibold" FontSize="13" CornerRadius="8" HeightRequest="42"
                Clicked="OnAddProductClicked"/>

        <!-- Content: list + editor inside a scroll view -->
        <ScrollView Grid.Row="2">
            <VerticalStackLayout Spacing="12">

                <!-- Loading indicator -->
                <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"
                                   Color="#111827" HorizontalOptions="Center"/>

                <!-- Products list -->
                <CollectionView ItemsSource="{Binding Products}" SelectionMode="None">
                    <CollectionView.EmptyView>
                        <Label Text="No products yet." TextColor="#9CA3AF"
                               HorizontalOptions="Center" Margin="0,30,0,0"/>
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:Product">
                            <Border BackgroundColor="White" Stroke="#E5E7EB" StrokeThickness="1"
                                    StrokeShape="RoundRectangle 10" Padding="12" Margin="0,0,0,10">
                                <VerticalStackLayout Spacing="10">

                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                        <Border WidthRequest="48" HeightRequest="48" BackgroundColor="#F3F4F6"
                                                Stroke="#D1D5DB" StrokeThickness="1" StrokeDashArray="3,3"
                                                StrokeShape="RoundRectangle 8">
                                            <Image Source="{Binding ImageUrl}" Aspect="AspectFill"/>
                                        </Border>

                                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                            <Label Text="{Binding Name}" FontFamily="OpenSansSemibold"
                                                   FontSize="14" TextColor="#111827"/>
                                            <Label Text="{Binding Description}" FontSize="11"
                                                   TextColor="#6B7280" LineBreakMode="TailTruncation"/>
                                        </VerticalStackLayout>

                                        <Label Grid.Column="2" Text="{Binding Price, StringFormat='R{0:0.00}'}"
                                               FontFamily="OpenSansSemibold" FontSize="14"
                                               TextColor="#111827" VerticalOptions="Start"/>
                                    </Grid>

                                    <BoxView HeightRequest="1" Color="#E5E7EB"/>

                                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                                        <Button Grid.Column="0" Text="Edit"
                                                BackgroundColor="White" TextColor="Black"
                                                BorderColor="#D1D5DB" BorderWidth="1" FontSize="12"
                                                CornerRadius="8" HeightRequest="36"
                                                Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.SelectForEditCommand}"
                                                CommandParameter="{Binding .}"/>
                                        <Button Grid.Column="1"
                                                Text="{Binding IsActive, StringFormat='Active: {0}'}"
                                                BackgroundColor="White" TextColor="Black"
                                                BorderColor="#D1D5DB" BorderWidth="1" FontSize="12"
                                                CornerRadius="8" HeightRequest="36"
                                                Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.ToggleActiveCommand}"
                                                CommandParameter="{Binding .}"/>
                                        <Button Grid.Column="2" Text="Delete"
                                                BackgroundColor="White" TextColor="#B3261E"
                                                BorderColor="#D1D5DB" BorderWidth="1" FontSize="12"
                                                CornerRadius="8" HeightRequest="36"
                                                Command="{Binding Source={x:Reference ThisPage}, Path=BindingContext.DeleteCommand}"
                                                CommandParameter="{Binding .}"/>
                                    </Grid>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <!-- Editor panel -->
                <Border BackgroundColor="#F9FAFB" Stroke="#E5E7EB" StrokeThickness="1"
                        StrokeShape="RoundRectangle 10" Padding="14" Margin="0,6,0,20">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="{Binding EditorTitle}" FontFamily="OpenSansSemibold"
                               FontSize="14" TextColor="#111827"/>

                        <Entry Placeholder="Product name" Text="{Binding DraftName}"/>
                        <Entry Placeholder="Description" Text="{Binding DraftDescription}"/>
                        <Entry Placeholder="Category (kits, sets, tools)" Text="{Binding DraftCategoryId}"/>
                        <Entry Placeholder="Price" Keyboard="Numeric" Text="{Binding DraftPrice}"/>
                        <Entry Placeholder="Stock (leave 0 for untracked)" Keyboard="Numeric"
                               Text="{Binding DraftStockQuantity}"/>
                        <Entry Placeholder="Image URL (optional)" Text="{Binding DraftImageUrl}"/>

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                            <Button Text="Save" Command="{Binding SaveCommand}"
                                    BackgroundColor="#111827" TextColor="White"
                                    CornerRadius="8" HeightRequest="42"/>
                            <Button Grid.Column="1" Text="Cancel"
                                    Command="{Binding StartNewProductCommand}"
                                    BackgroundColor="White" TextColor="Black"
                                    BorderColor="#D1D5DB" BorderWidth="1"
                                    CornerRadius="8" HeightRequest="42"/>
                        </Grid>

                        <Label Text="{Binding ErrorMessage}" TextColor="#B3261E" FontSize="12"
                               IsVisible="{Binding ErrorMessage, Converter={StaticResource IsNotNull}}"/>
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

    </Grid>
</ContentPage>