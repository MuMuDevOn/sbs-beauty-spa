<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:mi="http://www.aathifmahir.com/dotnet/2022/maui/icons"
             xmlns:local="clr-namespace:SBSBeautySpa.Mobile.Views.Admin"
             x:Class="SBSBeautySpa.Mobile.Views.Admin.AdminUploadGalleryPage"
             Shell.NavBarIsVisible="False">

    <!-- Same purple / blue / white theme as the rest of the app (only uses styles that exist in App.xaml) -->
    <Grid RowDefinitions="Auto,*,Auto" Padding="20,50,20,16"
          Background="{StaticResource PageGradient}">

        <!-- Header -->
        <VerticalStackLayout Grid.Row="0" Spacing="8">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                <Image WidthRequest="26" HeightRequest="26" VerticalOptions="Center"
                       mi:MauiIcon.Value="{mi:Material Icon=ArrowBack, IconColor=White}">
                    <Image.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBackTapped" />
                    </Image.GestureRecognizers>
                </Image>
                <Label Grid.Column="1" Text="Upload to Gallery" Style="{StaticResource PageTitle}" />
            </Grid>
            <Label Text="Add new photos, and remove ones you no longer want" Style="{StaticResource HintText}" />
        </VerticalStackLayout>

        <!-- Form -->
        <ScrollView Grid.Row="1" Margin="0,16,0,0">
            <VerticalStackLayout x:Name="ContentColumn" HorizontalOptions="Center" Spacing="18">
                <Border x:Name="FormCard" Style="{StaticResource GroupCard}">
                    <VerticalStackLayout Padding="16" Spacing="8">

                        <!-- Gallery photo -->
                        <Label Text="Gallery photo" Style="{StaticResource RowTitle}" />
                        <Border BackgroundColor="#F5F2FF" Stroke="#CFC6EE" StrokeThickness="1"
                            StrokeDashArray="4,3" StrokeShape="RoundRectangle 12" Padding="12">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">

                                <Border WidthRequest="96" HeightRequest="108" BackgroundColor="#E3DDFB"
                                    StrokeThickness="0" StrokeShape="RoundRectangle 10">
                                    <Image x:Name="PhotoPreview" Aspect="AspectFill" />
                                </Border>

                                <VerticalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="Center">
                                    <Label x:Name="PhotoStatusLabel" Text="No photo selected"
                                       Style="{StaticResource RowTitle}" FontSize="13" />
                                    <Label Text="JPG or PNG · up to 5 MB" Style="{StaticResource RowSubtitle}" />
                                    <Button x:Name="ChoosePhotoButton" Text="Choose photo"
                                        Style="{StaticResource OutlineButton}"
                                        HeightRequest="36" Clicked="OnReplacePhotoClicked" />
                                    <Label Text="Remove photo" Style="{StaticResource RowSubtitle}"
                                       TextColor="#6D3FE0" TextDecorations="Underline">
                                        <Label.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnRemovePhotoTapped" />
                                        </Label.GestureRecognizers>
                                    </Label>
                                </VerticalStackLayout>
                            </Grid>
                        </Border>

                        <!-- Design title -->
                        <Label Text="Design title" Style="{StaticResource RowTitle}" Margin="0,8,0,0" />
                        <Border BackgroundColor="#EFE9FF" StrokeThickness="0" StrokeShape="RoundRectangle 14"
                            Padding="14,0" HeightRequest="46">
                            <Entry x:Name="TitleEntry" Placeholder="e.g. Rose Gold Chrome"
                               Style="{StaticResource FieldEntry}" FontSize="14" VerticalOptions="Center" />
                        </Border>

                        <!-- Shape / category -->
                        <Label Text="Shape / category" Style="{StaticResource RowTitle}" Margin="0,8,0,0" />
                        <Border BackgroundColor="#EFE9FF" StrokeThickness="0" StrokeShape="RoundRectangle 14"
                            Padding="14,0" HeightRequest="46">
                            <Grid ColumnDefinitions="*,Auto">
                                <Picker x:Name="CategoryPicker" Title="Select a shape"
                                    Style="{StaticResource FieldPicker}" FontSize="14"
                                    VerticalOptions="Center"
                                    SelectedIndexChanged="OnCategoryChanged">
                                    <Picker.ItemsSource>
                                        <x:Array Type="{x:Type x:String}">
                                            <x:String>Almond</x:String>
                                            <x:String>Coffin</x:String>
                                            <x:String>Square</x:String>
                                            <x:String>Stiletto</x:String>
                                            <x:String>Round</x:String>
                                            <x:String>Oval</x:String>
                                        </x:Array>
                                    </Picker.ItemsSource>
                                </Picker>
                                <Image Grid.Column="1" WidthRequest="22" HeightRequest="22" VerticalOptions="Center"
                                   mi:MauiIcon.Value="{mi:Material Icon=ExpandMore, IconColor=#6E63A6}">
                                    <Image.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnChevronTapped" />
                                    </Image.GestureRecognizers>
                                </Image>
                            </Grid>
                        </Border>

                        <!-- Style tags -->
                        <Label Text="Style tags" Style="{StaticResource RowTitle}" Margin="0,8,0,0" />
                        <FlexLayout x:Name="TagsLayout" Wrap="Wrap">
                            <Border Stroke="#A59CC9" StrokeThickness="1" StrokeDashArray="4,3"
                                StrokeShape="RoundRectangle 10" Padding="10,6" Margin="0,0,8,8">
                                <Label Text="+ Add tag" FontSize="12" TextColor="#6D3FE0" VerticalOptions="Center" />
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnAddTagTapped" />
                                </Border.GestureRecognizers>
                            </Border>
                        </FlexLayout>

                        <!-- Caption -->
                        <Label Text="Caption" Style="{StaticResource RowTitle}" Margin="0,4,0,0" />
                        <Border BackgroundColor="#EFE9FF" StrokeThickness="0" StrokeShape="RoundRectangle 14"
                            Padding="14,6">
                            <Editor x:Name="CaptionEditor" HeightRequest="80"
                                Placeholder="Write a caption..."
                                Style="{StaticResource FieldEditor}" FontSize="14" />
                        </Border>

                        <!-- Info note -->
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" Margin="0,4,0,0">
                            <Image WidthRequest="16" HeightRequest="16" VerticalOptions="Start"
                               mi:MauiIcon.Value="{mi:Material Icon=Visibility, IconColor=#6E63A6}" />
                            <Label x:Name="InfoLabel" Grid.Column="1" Style="{StaticResource RowSubtitle}"
                               Text="Pick a shape. Published photos appear in that shape's gallery with your title and style tags." />
                        </Grid>

                        <!-- Errors / progress -->
                        <Label x:Name="ErrorLabel" TextColor="#D92D20" FontSize="13" IsVisible="False" />
                        <ActivityIndicator x:Name="Busy" IsRunning="False" IsVisible="False" Color="#6D3FE0" />

                    </VerticalStackLayout>
                </Border>

                <!-- Photos already in the gallery -->
                <VerticalStackLayout Spacing="10">
                    <Label x:Name="ListTitle" Text="PHOTOS IN THE GALLERY" Style="{StaticResource CapsLabel}" />
                    <Label x:Name="ListErrorLabel" TextColor="#FECACA" FontFamily="OpenSansRegular"
                       FontSize="13" IsVisible="False" />
                    <Label x:Name="ListInfoLabel" TextColor="#BBF7D0" FontFamily="OpenSansSemibold"
                       FontSize="13" IsVisible="False" />

                    <VerticalStackLayout x:Name="PhotoList" Spacing="10">
                        <BindableLayout.EmptyView>
                            <Label Text="No photos in the gallery yet." Style="{StaticResource HintText}" />
                        </BindableLayout.EmptyView>
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="local:GalleryRow">
                                <Border BackgroundColor="White" StrokeThickness="0"
                                    StrokeShape="RoundRectangle 20" Padding="12">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">

                                        <Border WidthRequest="72" HeightRequest="72" BackgroundColor="#EFE9FF"
                                            StrokeThickness="0" StrokeShape="RoundRectangle 14"
                                            VerticalOptions="Center">
                                            <Image Source="{Binding ImageUrl}" Aspect="AspectFill" />
                                        </Border>

                                        <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                                            <Label Text="{Binding Title}" Style="{StaticResource RowTitle}"
                                               LineBreakMode="TailTruncation" />
                                            <Label Text="{Binding ShapeName}" Style="{StaticResource RowSubtitle}" />
                                        </VerticalStackLayout>

                                        <Button Grid.Column="2" Text="Remove" FontFamily="OpenSansSemibold"
                                            FontSize="12" HeightRequest="38" Padding="16,0" CornerRadius="19"
                                            BackgroundColor="White" TextColor="#D92D20"
                                            BorderColor="#D92D20" BorderWidth="1"
                                            VerticalOptions="Center"
                                            Clicked="OnRemoveClicked"
                                            CommandParameter="{Binding .}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>

                <BoxView HeightRequest="8" Color="Transparent" />
            </VerticalStackLayout>
        </ScrollView>

        <!-- Button -->
        <Button x:Name="PublishButton" Grid.Row="2" Text="Publish to Gallery"
                Style="{StaticResource PrimaryButton}" Margin="0,12,0,0"
                HorizontalOptions="Center"
                HeightRequest="48" FontSize="15" Clicked="OnPublishClicked" />
    </Grid>
</ContentPage>
