// firestore.rules
// This file controls who can read/write Firestore from the mobile app.
// Cloud Functions use the Admin SDK — they bypass these rules.
// If a direct write is denied, that's correct — it should use a function.
// 

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    //Helper functions

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    function isSuperAdmin() {
      return isSignedIn() && request.auth.token.superAdmin == true;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    //Public catalog: anyone reads, functions write
    match /services/{id}               { allow read: if true; allow write: if false; }
    match /serviceCategories/{id}      { allow read: if true; allow write: if false; }
    match /products/{id}               { allow read: if true; allow write: if false; }
    match /productCategories/{id}      { allow read: if true; allow write: if false; }
    match /galleryCategories/{id}      { allow read: if true; allow write: if false; }
    match /galleryImages/{id}          { allow read: if true; allow write: if false; }
    match /businessSettingsPublic/{id} { allow read: if true; allow write: if false; }
    match /reviews/{id}                { allow read: if true; allow write: if false; }

    // Business hours: signed-in only
    match /businessHours/{id} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // Own data

    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if isOwner(uid);
    }

    match /clientPreferences/{uid} {
      allow read, write: if isOwner(uid) || isAdmin();
    }

    match /cartItems/{itemId} {
      allow read, delete: if isSignedIn() && resource.data.clientId == request.auth.uid;
      allow create, update: if isSignedIn() && request.resource.data.clientId == request.auth.uid;
    }

    //Bookings / Orders / Payments: read own, write never

    match /bookings/{id} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.clientId == request.auth.uid);
      allow write: if false;
    }

    match /orders/{id} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.clientId == request.auth.uid);
      allow write: if false;
    }

    match /payments/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Notifications: read own, only flip isRead

    match /notifications/{id} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.clientId == request.auth.uid);
      allow update: if isSignedIn()
        && resource.data.clientId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']);
      allow create, delete: if false;
    }

    //Admin-only: no client access

    match /clientNotes/{id}             { allow read, write: if false; }
    match /bookingNotes/{id}            { allow read, write: if false; }
    match /businessSettingsPrivate/{id} { allow read, write: if false; }
    match /contactMessages/{id}         { allow read, write: if false; }
    match /deletionLog/{id}             { allow read, write: if false; }

    // Default: deny everything else 

    match /{document=**} {
      allow read, write: if false;
    }
  }
}